# odootour 环境变量（复制为 .env 后填真实值；.env 不入库）
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME

# Odoo master 口令明文（admin-hash 目标用它生成 pbkdf2 写入 config/odoo.conf）
ADMIN_PASSWD=CHANGE_ME

# 镜像源码 pin（github odoo/odoo 20.0 分支 commit，升级时显式更换并记录 ODOO_PIN.md）
ODOO_COMMIT=c7f7429776e018c20dbad9ae5a9873345635b661

# 装 tour_* 客制模块（B1 阶段）前必须与 tms 完全一致：
# TMS_FIELD_ENCRYPT_KEY=

# 运行数据家目录：pg(数据)/odoo_config/cust_addons/vendor/backup/odoo_log 均在此
ODOOTOUR_HOME=/home/adai/odoo20tour
