<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ta_expense" model="ir.actions.act_window">
        <field name="name">费用报销</field>
        <field name="res_model">ta.expense</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ta_expense_list" model="ir.ui.view">
        <field name="name">ta.expense.list</field>
        <field name="model">ta.expense</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="reason"/>
                <field name="expense_type"/>
                <field name="applicant_id" widget="many2one_avatar_user"/>
                <field name="departure_id" optional="hide"/>
                <field name="amount" sum="合计"/>
                <field name="approved_by" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ta_expense_form" model="ir.ui.view">
        <field name="name">ta.expense.form</field>
        <field name="model">ta.expense</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="提交" type="object"
                            invisible="state not in ('draft', 'rejected')" class="oe_highlight"/>
                    <button name="action_approve" string="审核通过" type="object"
                            invisible="state != 'submitted'" class="oe_highlight"
                            groups="ta_base.group_ta_accountant"/>
                    <button name="action_reject" string="驳回" type="object"
                            invisible="state != 'submitted'"
                            groups="ta_base.group_ta_accountant"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reason" placeholder="事由，如：上海考察高铁票"/>
                            <field name="expense_type"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="applicant_id" readonly="state != 'draft'"
                                   widget="many2one_avatar_user"/>
                            <field name="departure_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoice_ref"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="备注">
                        <field name="note" nolabel="1" placeholder="补充说明（可选）"/>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ta_expense_search" model="ir.ui.view">
        <field name="name">ta.expense.search</field>
        <field name="model">ta.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reason"/>
                <field name="applicant_id"/>
                <field name="departure_id"/>
                <filter name="my_expenses" string="我的报销"
                        domain="[('applicant_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="草稿" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="待审核" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="已审核" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="group_type" string="费用类型" context="{'group_by': 'expense_type'}"/>
                <filter name="group_applicant" string="报销人" context="{'group_by': 'applicant_id'}"/>
                <filter name="group_date" string="费用月份" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>
</odoo>
