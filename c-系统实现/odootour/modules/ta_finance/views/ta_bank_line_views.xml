<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ta_bank_line" model="ir.actions.act_window">
        <field name="name">收款登记（银行到账）</field>
        <field name="res_model">ta.bank.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ta_bank_line_list" model="ir.ui.view">
        <field name="name">ta.bank.line.list</field>
        <field name="model">ta.bank.line</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'claimed'" create="true">
                <field name="date"/>
                <field name="ref"/>
                <field name="journal_id"/>
                <field name="partner_name"/>
                <field name="amount" sum="合计"/>
                <field name="claimed_amount"/>
                <field name="residual"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_claim'"
                       decoration-warning="state == 'partial'"
                       decoration-success="state == 'claimed'"/>
                <field name="registered_by" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ta_bank_line_search" model="ir.ui.view">
        <field name="name">ta.bank.line.search</field>
        <field name="model">ta.bank.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="date"/>
                <field name="ref" string="流水号/摘要"/>
                <field name="journal_id"/>
                <field name="partner_name" string="往来单位"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="registered_by"/>
                <filter name="state_to_claim" string="待认领" domain="[('state', '=', 'to_claim')]"/>
                <filter name="state_partial" string="部分认领" domain="[('state', '=', 'partial')]"/>
                <filter name="state_claimed" string="已认领" domain="[('state', '=', 'claimed')]"/>
                <separator/>
                <filter name="group_date" string="到账日期" context="{'group_by': 'date'}"/>
                <filter name="group_journal" string="收款账户" context="{'group_by': 'journal_id'}"/>
                <filter name="group_state" string="状态" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_ta_bank_line_form" model="ir.ui.view">
        <field name="name">ta.bank.line.form</field>
        <field name="model">ta.bank.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="ref" placeholder="流水号/摘要"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="partner_name"/>
                            <field name="partner_id"/>
                            <field name="registered_by" readonly="1"/>
                            <field name="state" widget="statusbar"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="claimed_amount"/>
                            <field name="residual"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="认领明细" name="claims">
                            <field name="claim_line_ids" readonly="1">
                                <list>
                                    <field name="claim_id"/>
                                    <field name="amount"/>
                                    <field name="claim_state" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="备注" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
