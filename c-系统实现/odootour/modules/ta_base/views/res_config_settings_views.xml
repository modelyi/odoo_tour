<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_form_ta" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ta.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="旅行社" string="旅行社管理" name="ta_base" groups="ta_base.group_ta_manager">
                    <block title="单团核算口径" name="ta_pnl_block">
                        <setting string="成本含税拆分"
                                 help="勾选后成本按含税录入，单团毛利按 BS-19 口径 cost_net = cost_total/(1+r) 自动拆分；与含税利润口径互斥。">
                            <field name="ta_cost_tax_split"/>
                            <div class="content-group" invisible="not ta_cost_tax_split">
                                <field name="ta_default_tax_rate" class="o_light_label"/>
                            </div>
                        </setting>
                    </block>
                    <block title="收入成本确认（BS-14 / BS-10 §7.2）" name="ta_revenue_block">
                        <setting string="纳税人身份" help="决定收入确认默认税率：一般纳税人 6%、小规模 3%；切换身份会重设默认税率，可再手改。">
                            <field name="ta_taxpayer_type"/>
                        </setting>
                        <setting string="收入增值税率" help="收入确认拆税率（小数，如 0.06）。0 表示不拆税。">
                            <field name="ta_vat_rate"/>
                        </setting>
                        <setting string="41 代订差价拆销项税"
                                 help="默认关：差价含税全额进 6001.03 代订收入；开票体系（BS-12）落地后按需启用。">
                            <field name="ta_revenue_dd_split_tax"/>
                        </setting>
                        <setting string="发团自动确认收入"
                                 help="勾选后发团动作自动生成收入确认凭证；不勾选则仅在发团表单手动点击「确认收入」。">
                            <field name="ta_revenue_auto_on_depart"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
