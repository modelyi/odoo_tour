<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ta_biz_mode_tree" model="ir.ui.view">
        <field name="name">ta.biz.mode.tree</field>
        <field name="model">ta.biz.mode</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="is_alias"/>
                <field name="alias_of" optional="show"/>
                <field name="partner_share" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ta_biz_mode_form" model="ir.ui.view">
        <field name="name">ta.biz.mode.form</field>
        <field name="model">ta.biz.mode</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="is_alias"/>
                            <field name="alias_of" invisible="not is_alias"/>
                        </group>
                        <group>
                            <field name="partner_share"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ta_biz_mode" model="ir.actions.act_window">
        <field name="name">业务模式码</field>
        <field name="res_model">ta.biz.mode</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
