<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_ta" model="ir.module.category">
            <field name="name">旅行社管理</field>
            <field name="description">V20 核心闭环角色</field>
            <field name="sequence">50</field>
        </record>

        <record id="privilege_ta" model="res.groups.privilege">
            <field name="name">旅行社</field>
            <field name="category_id" ref="module_category_ta"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_ta_sales" model="res.groups">
            <field name="name">销售/外联</field>
            <field name="privilege_id" ref="privilege_ta"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">线路查询、报价、下单报名；可发起收款认领，不得审核。</field>
        </record>
        <record id="group_ta_dispatcher" model="res.groups">
            <field name="name">计调</field>
            <field name="privilege_id" ref="privilege_ta"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">班期排期、资源预订、成本控制。</field>
        </record>
        <record id="group_ta_cashier" model="res.groups">
            <field name="name">出纳</field>
            <field name="privilege_id" ref="privilege_ta"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">收款登记（三步闭环第 1 步）。</field>
        </record>
        <record id="group_ta_accountant" model="res.groups">
            <field name="name">会计/财务经理</field>
            <field name="privilege_id" ref="privilege_ta"/>
            <field name="sequence">40</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">认领审核（第 3 步）、凭证与单团核算口径。</field>
        </record>
        <record id="group_ta_guide" model="res.groups">
            <field name="name">导游</field>
            <field name="privilege_id" ref="privilege_ta"/>
            <field name="sequence">50</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">带团费用、报账、借款。</field>
        </record>
        <record id="group_ta_manager" model="res.groups">
            <field name="name">管理层</field>
            <field name="privilege_id" ref="privilege_ta"/>
            <field name="sequence">60</field>
            <field name="implied_ids" eval="[(4, ref('group_ta_sales')), (4, ref('group_ta_dispatcher')), (4, ref('group_ta_accountant'))]"/>
            <field name="comment">经营报表与最终审批。</field>
        </record>
    </data>
</odoo>
