<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_bank_account_search" model="ir.ui.view">
        <field name="name">tour.bank.account.search</field>
        <field name="model">tour.bank.account</field>
        <field name="arch" type="xml">
            <search string="银行账户搜索">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="acc_number_masked"/>
                <field name="account_type"/>
                <field name="company_id"/>
                <field name="department_id"/>
                <separator/>
                <filter name="group_type" string="账户类型" context="{'group_by':'account_type'}"/>
                <filter name="group_company" string="公司" context="{'group_by':'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_tour_bank_account" model="ir.actions.act_window">
        <field name="name">银行账户</field>
        <field name="res_model">tour.bank.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tour_bank_account_search"/>
    </record>

    <record id="view_tour_bank_account_list" model="ir.ui.view">
        <field name="name">tour.bank.account.list</field>
        <field name="model">tour.bank.account</field>
        <field name="arch" type="xml">
            <list string="银行账户">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="acc_number_masked" string="卡号"/>
                <field name="account_type"/>
                <field name="currency_id"/>
                <field name="balance"/>
                <field name="trans_fee_rate"/>
                <field name="company_id"/>
                <field name="department_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tour_bank_account_form" model="ir.ui.view">
        <field name="name">tour.bank.account.form</field>
        <field name="model">tour.bank.account</field>
        <field name="arch" type="xml">
            <form string="银行账户">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="账户名称"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="bank_id"/>
                            <field name="account_type"/>
                            <field name="currency_id"/>
                            <field name="balance"/>
                            <field name="trans_fee_rate"/>
                        </group>
                        <group>
                            <field name="acc_number_masked" string="卡号（掩码）"/>
                            <field name="acc_number" groups="tour_accounting.group_tour_accounting_treasurer"/>
                            <field name="taxpayer_no"/>
                            <field name="active"/>
                            <field name="power_area"/>
                        </group>
                    </group>
                    <group string="归属">
                        <field name="company_id"/>
                        <field name="department_id"/>
                    </group>
                    <group string="备注">
                        <field name="remark"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
