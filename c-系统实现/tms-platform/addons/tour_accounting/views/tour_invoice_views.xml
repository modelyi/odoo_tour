<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         account.move 表单扩展：旅行社差额征税发票字段 + 扣除明细 [BS-12 §8.1/§8.2]
    ================================================================ -->
    <record id="view_move_form_tour_invoice" model="ir.ui.view">
        <field name="name">account.move.form.tour.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- 工作流按钮：开票状态流转 -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_apply"
                    type="object"
                    string="提交申请"
                    class="btn-primary"
                    invisible="tour_invoice_state != 'draft' or move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_cancel_apply"
                    type="object"
                    string="撤回申请"
                    class="btn-secondary"
                    invisible="tour_invoice_state != 'applied'"/>
                <button name="action_issue"
                    type="object"
                    string="开具发票"
                    class="btn-primary"
                    invisible="tour_invoice_state != 'applied'"/>
                <button name="action_void"
                    type="object"
                    string="作废"
                    class="btn-danger"
                    invisible="tour_invoice_state != 'issued'"/>
                <button name="action_reverse"
                    type="object"
                    string="红冲"
                    class="btn-danger"
                    invisible="tour_invoice_state != 'issued'"/>
            </xpath>
            <xpath expr="//page[@id='aml_tab']" position="before">
                <page string="旅行社发票" name="tour_invoice">
                    <group>
                        <group string="开票信息">
                            <field name="tour_invoice_kind"/>
                            <field name="tour_is_diff_tax"/>
                            <field name="tour_invoice_state"/>
                            <field name="tour_invoice_apply_date"/>
                            <field name="tour_invoice_issue_date"/>
                            <field name="tour_invoice_no"/>
                        </group>
                        <group string="团关联">
                            <field name="tour_plan_id"
                                   domain="[('state', 'not in', ('cancelled', 'void'))]"/>
                            <field name="tour_plan_ids" widget="many2many_tags"
                                   domain="[('state', 'not in', ('cancelled', 'void'))]"/>
                        </group>
                    </group>
                    <group string="差额征税票面要素" invisible="not tour_is_diff_tax">
                        <field name="tour_diff_gross"/>
                        <field name="tour_diff_deduct"/>
                        <field name="tour_diff_base"/>
                        <field name="tour_diff_tax"/>
                    </group>
                    <group string="差额扣除明细" invisible="not tour_is_diff_tax">
                        <field name="tour_deduct_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="deduct_type"/>
                                <field name="amount"/>
                                <field name="account_id"
                                       domain="[('tour_vat_deductible', '=', True)]"/>
                                <field name="cost_move_line_id"/>
                                <field name="invoice_collected"/>
                            </list>
                        </field>
                    </group>
                    <group string="收款认领回链（闭环）">
                        <field name="tour_claim_line_ids" nolabel="1">
                            <list>
                                <field name="claim_id"/>
                                <field name="amount"/>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         发票管理专用列表视图（旅行社开票字段）
    ================================================================ -->
    <record id="view_tour_invoice_list" model="ir.ui.view">
        <field name="name">account.move.list.tour.invoice</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="旅行社发票"
                  decoration-info="tour_invoice_state == 'draft'"
                  decoration-warning="tour_invoice_state == 'applied'"
                  decoration-success="tour_invoice_state == 'issued'"
                  decoration-muted="tour_invoice_state in ('void', 'reversed')">
                <field name="name" string="发票号"/>
                <field name="partner_id" string="客户"/>
                <field name="tour_plan_id" string="关联团"/>
                <field name="tour_invoice_kind" string="发票类型"/>
                <field name="tour_is_diff_tax" string="差额征税"/>
                <field name="tour_invoice_state" string="开票状态"
                       widget="badge"
                       decoration-info="tour_invoice_state == 'draft'"
                       decoration-warning="tour_invoice_state == 'applied'"
                       decoration-success="tour_invoice_state == 'issued'"
                       decoration-danger="tour_invoice_state in ('void', 'reversed')"/>
                <field name="invoice_date" string="账单日期"/>
                <field name="tour_invoice_apply_date" string="申请日期"/>
                <field name="tour_invoice_issue_date" string="开具日期"/>
                <field name="amount_total_signed" string="价税合计"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         发票管理搜索视图
    ================================================================ -->
    <record id="view_tour_invoice_search" model="ir.ui.view">
        <field name="name">account.move.search.tour.invoice</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="发票搜索">
                <field name="name" string="发票号"/>
                <field name="partner_id" string="客户"/>
                <field name="tour_plan_id" string="关联团"/>
                <separator/>
                <filter name="filter_draft" string="待申请"
                        domain="[('tour_invoice_state', '=', 'draft')]"/>
                <filter name="filter_applied" string="已申请"
                        domain="[('tour_invoice_state', '=', 'applied')]"/>
                <filter name="filter_issued" string="已开具"
                        domain="[('tour_invoice_state', '=', 'issued')]"/>
                <filter name="filter_void" string="已作废"
                        domain="[('tour_invoice_state', '=', 'void')]"/>
                <filter name="filter_reversed" string="已红冲"
                        domain="[('tour_invoice_state', '=', 'reversed')]"/>
                <separator/>
                <filter name="filter_diff_tax" string="差额征税"
                        domain="[('tour_is_diff_tax', '=', True)]"/>
                <separator/>
                <filter name="group_state" string="开票状态"
                        context="{'group_by': 'tour_invoice_state'}"/>
                <filter name="group_kind" string="发票类型"
                        context="{'group_by': 'tour_invoice_kind'}"/>
                <filter name="group_partner" string="客户"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_plan" string="关联团"
                        context="{'group_by': 'tour_plan_id'}"/>
                <filter name="group_issue_date" string="开具月份"
                        context="{'group_by': 'tour_invoice_issue_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ================================================================
         4 个菜单 action（按 tour_invoice_state 分域）
    ================================================================ -->

    <!-- 开票申请：待申请的发票 -->
    <record id="action_tour_invoice_apply" model="ir.actions.act_window">
        <field name="name">开票申请</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_tour_invoice_list')}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="search_view_id" ref="view_tour_invoice_search"/>
        <field name="domain">[
            ('move_type', 'in', ('out_invoice', 'out_refund')),
            ('tour_invoice_state', '=', 'draft')
        ]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_tour_invoice_state': 'draft'}</field>
    </record>

    <!-- 开票审核：已申请待审核的发票 -->
    <record id="action_tour_invoice_audit" model="ir.actions.act_window">
        <field name="name">开票审核</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_tour_invoice_list')}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="search_view_id" ref="view_tour_invoice_search"/>
        <field name="domain">[
            ('move_type', 'in', ('out_invoice', 'out_refund')),
            ('tour_invoice_state', '=', 'applied')
        ]</field>
    </record>

    <!-- 发票开具：已开具的发票 -->
    <record id="action_tour_invoice_issue" model="ir.actions.act_window">
        <field name="name">发票开具</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_tour_invoice_list')}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="search_view_id" ref="view_tour_invoice_search"/>
        <field name="domain">[
            ('move_type', 'in', ('out_invoice', 'out_refund')),
            ('tour_invoice_state', '=', 'issued')
        ]</field>
    </record>

    <!-- 发票列表：所有客户发票 -->
    <record id="action_tour_invoice_list" model="ir.actions.act_window">
        <field name="name">发票列表</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_tour_invoice_list')}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="search_view_id" ref="view_tour_invoice_search"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <!-- ================================================================
         tour.plan 表单扩展：开票进度 [BS-12 §4.3/§8.3]
    ================================================================ -->
    <record id="view_tour_plan_form_invoice" model="ir.ui.view">
        <field name="name">tour.plan.form.invoice</field>
        <field name="model">tour.plan</field>
        <field name="inherit_id" ref="tour_order.view_tour_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='un_invoice_money']" position="after">
                <field name="invoice_amount_total"/>
                <field name="invoice_progress" widget="progressbar"/>
                <field name="invoice_ids" widget="many2many_tags"
                       domain="[('move_type', 'in', ('out_invoice', 'out_refund'))]"/>
            </xpath>
        </field>
    </record>
</odoo>
