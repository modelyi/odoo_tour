<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 会计期间视图 -->
    <record id="view_tour_account_period_list" model="ir.ui.view">
        <field name="name">tour.account.period.list</field>
        <field name="model">tour.account.period</field>
        <field name="arch" type="xml">
            <list string="会计期间">
                <field name="code"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'open'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>
    
    <record id="view_tour_account_period_form" model="ir.ui.view">
        <field name="name">tour.account.period.form</field>
        <field name="model">tour.account.period</field>
        <field name="arch" type="xml">
            <form string="会计期间">
                <header>
                    <button name="action_open" string="开放" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="关闭" type="object" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_reset" string="重置" type="object" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_tour_account_period" model="ir.actions.act_window">
        <field name="name">会计期间</field>
        <field name="res_model">tour.account.period</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                创建第一个会计期间
            </p>
            <p>
                会计期间用于管理办公费用的记账期间，控制费用录入的时间范围。
            </p>
        </field>
    </record>
    
    <!-- 办公费用统计报表视图 -->
    <record id="view_tour_office_expense_report_form" model="ir.ui.view">
        <field name="name">tour.office.expense.report.form</field>
        <field name="model">tour.office.expense.report</field>
        <field name="arch" type="xml">
            <form string="办公费用统计报表">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="group_by"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" string="生成报表" type="object" class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_tour_office_expense_report" model="ir.actions.act_window">
        <field name="name">办公费用统计</field>
        <field name="res_model">tour.office.expense.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <!-- 办公费用统计报表结果视图 -->
    <record id="view_tour_office_expense_report_result_form" model="ir.ui.view">
        <field name="name">tour.office.expense.report.result.form</field>
        <field name="model">tour.office.expense.report.result</field>
        <field name="arch" type="xml">
            <form string="办公费用统计报表">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="group_by"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="total_count"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="明细">
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="name"/>
                                    <field name="count"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="关闭" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
