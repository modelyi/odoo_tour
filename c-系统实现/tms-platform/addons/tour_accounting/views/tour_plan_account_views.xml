<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_plan_account_search" model="ir.ui.view">
        <field name="name">tour.plan.account.search</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <search string="单团核算搜索">
                <field name="plan_code"/>
                <field name="plan_id"/>
                <field name="line_id"/>
                <field name="sales_name"/>
                <field name="supplier_id"/>
                <field name="biz_mode"/>
                <field name="company_id"/>
                <field name="department_id"/>
                <separator/>
                <filter name="group_biz" string="业务模式" context="{'group_by':'biz_mode'}"/>
                <filter name="group_state" string="状态" context="{'group_by':'state'}"/>
                <filter name="group_line" string="线路" context="{'group_by':'line_id'}"/>
                <filter name="group_sales" string="销售归属" context="{'group_by':'sales_name'}"/>
                <filter name="group_supplier" string="客户" context="{'group_by':'supplier_id'}"/>
                <filter name="receivable_positive" string="真应收(客户欠款)"
                        domain="[('receivable_positive','>',0)]"/>
                <filter name="receivable_negative" string="溢缴(转预收)"
                        domain="[('receivable_negative','>',0)]"/>
                <filter name="state_accounting" string="核算中" domain="[('state','=','accounting')]"/>
                <filter name="state_settled" string="已结算" domain="[('state','=','settled')]"/>
                <filter name="state_archived" string="已归档" domain="[('state','=','archived')]"/>
            </search>
        </field>
    </record>

    <record id="action_tour_plan_account" model="ir.actions.act_window">
        <field name="name">单团核算</field>
        <field name="res_model">tour.plan.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tour_plan_account_search"/>
    </record>

    <record id="view_tour_plan_account_list" model="ir.ui.view">
        <field name="name">tour.plan.account.list</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <list string="单团核算">
                <field name="plan_code"/>
                <field name="plan_id"/>
                <field name="biz_mode"/>
                <field name="income_total" sum="收入合计"/>
                <field name="income_commission"/>
                <field name="cost_total" sum="成本合计"/>
                <field name="cost_net_total" sum="不含税成本"/>
                <field name="receivable"/>
                <field name="profit" sum="毛利(不含税)"/>
                <field name="profit_no_shop"/>
                <field name="profit_tax_incl" sum="毛利(含税口径)"/>
                <field name="state" widget="badge" decoration-success="state=='settled'" decoration-info="state=='accounting'" decoration-muted="state=='archived'"/>
            </list>
        </field>
    </record>

    <record id="view_tour_plan_account_form" model="ir.ui.view">
        <field name="name">tour.plan.account.form</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <form string="单团核算">
                <header>
                    <button name="action_settle" string="结算" type="object" class="btn-primary"
                        invisible="state != 'accounting'"/>
                    <button name="action_archive" string="归档" type="object"
                        invisible="state != 'settled'"/>
                    <button name="action_reopen" string="重开核算" type="object"
                        invisible="state == 'accounting'"/>
                    <field name="state" widget="statusbar" statusbar_visible="accounting,settled,archived"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="plan_code"/>
                            <field name="biz_mode"/>
                        </group>
                        <group>
                            <field name="analytic_account_id"/>
                            <field name="company_id"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="收入">
                            <group>
                                <field name="income_total"/>
                                <field name="income_commission"/>
                            </group>
                        </page>
                        <page string="成本">
                            <group>
                                <field name="cost_total"/>
                                <field name="cost_deductible"/>
                                <field name="cost_non_deductible"/>
                            </group>
                        </page>
                        <page string="增值税">
                            <group>
                                <field name="vat_deductible_total"/>
                                <field name="vat_deduct_amount"/>
                                <field name="vat_output_amount"/>
                                <field name="vat_payable"/>
                            </group>
                        </page>
                        <page string="应收/预收/发票">
                            <group>
                                <field name="receivable"/>
                                <field name="receivable_positive"/>
                                <field name="receivable_negative"/>
                                <field name="prepaid"/>
                                <field name="invoice_gap"/>
                            </group>
                        </page>
                        <page string="应收账龄">
                            <group>
                                <field name="overdue_days"/>
                                <field name="aging_0_30"/>
                                <field name="aging_31_90"/>
                                <field name="aging_91_180"/>
                                <field name="aging_181_365"/>
                                <field name="aging_over_365"/>
                            </group>
                        </page>
                        <page string="利润">
                            <group>
                                <field name="cost_net_total"/>
                                <field name="profit"/>
                                <field name="profit_no_shop"/>
                                <field name="profit_tax_incl"/>
                            </group>
                            <group>
                                <field name="income_commission"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 团款应收四维账龄分析（BS-12 §5.2）：按团/线路/销售员/客户 pivot 分析 -->
    <record id="view_tour_plan_account_aging_pivot" model="ir.ui.view">
        <field name="name">tour.plan.account.aging.pivot</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <pivot string="团款应收四维账龄" disable_linking="True">
                <field name="line_id" type="row"/>
                <field name="sales_name" type="col"/>
                <field name="supplier_id" type="row"/>
                <field name="receivable_positive" type="measure"/>
                <field name="aging_0_30" type="measure"/>
                <field name="aging_31_90" type="measure"/>
                <field name="aging_91_180" type="measure"/>
                <field name="aging_181_365" type="measure"/>
                <field name="aging_over_365" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tour_plan_account_aging_graph" model="ir.ui.view">
        <field name="name">tour.plan.account.aging.graph</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <graph string="团款应收账龄分布">
                <field name="line_id"/>
                <field name="receivable_positive" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_tour_plan_account_aging" model="ir.actions.act_window">
        <field name="name">团款应收账龄分析（四维）</field>
        <field name="res_model">tour.plan.account</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_tour_plan_account_search"/>
        <field name="domain">[('receivable_positive', '&gt;', 0)]</field>
        <field name="context">{'search_default_receivable_positive': 1}</field>
    </record>
</odoo>
