<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 员工自助权限 [BS-15 §7.7]
         员工（hr.employee 关联 res.users）仅见/写自己的借款与报账；
         财务角色（tour_base.group_tour_finance）全权（审批/放款/审核/付款）。
         组合语义：不同 group 的 record rule 取 OR，财务用户同时在 base.group_user 与
         tour_base.group_tour_finance，故见 (自己的 ∪ 全部) = 全部；
         非财务内部用户只在 base.group_user，仅见自己。 -->

    <!-- ============ 借款单 ============ -->
    <record id="rule_tour_guide_loan_self" model="ir.rule">
        <field name="name">借款单：员工仅见本人</field>
        <field name="model_id" ref="model_tour_guide_loan"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('applicant_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_tour_guide_loan_finance" model="ir.rule">
        <field name="name">借款单：财务全权</field>
        <field name="model_id" ref="model_tour_guide_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tour_base.group_tour_finance'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============ 报账单 ============ -->
    <record id="rule_tour_guide_real_pay_self" model="ir.rule">
        <field name="name">报账单：员工仅见本人</field>
        <field name="model_id" ref="model_tour_guide_real_pay"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_tour_guide_real_pay_finance" model="ir.rule">
        <field name="name">报账单：财务全权</field>
        <field name="model_id" ref="model_tour_guide_real_pay"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tour_base.group_tour_finance'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============ 报销明细行 ============ -->
    <record id="rule_tour_guide_expense_line_self" model="ir.rule">
        <field name="name">报销明细行：员工仅见本人</field>
        <field name="model_id" ref="model_tour_guide_expense_line"/>
        <field name="domain_force">[('real_pay_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_tour_guide_expense_line_finance" model="ir.rule">
        <field name="name">报销明细行：财务全权</field>
        <field name="model_id" ref="model_tour_guide_expense_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tour_base.group_tour_finance'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
