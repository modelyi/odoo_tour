<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 资产增减变动表打印模板 -->
    <template id="report_asset_change_document">
        <t t-set="data" t-value="data"/>
        <t t-set="company" t-value="env.company"/>
        <div class="page" t-attf-style="font-family: 'SimSun', serif; font-size: 11px;">
            <!-- 报表头部 -->
            <div class="row" style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 10px;">
                <div class="col-4 text-start">
                    <span t-out="company.name" style="font-size: 14px;"/>
                </div>
                <div class="col-4 text-center">
                    <h2 style="font-weight: bold; letter-spacing: 4px; margin: 0;">固定资产增减变动表</h2>
                </div>
                <div class="col-4 text-end" style="font-size: 11px;">
                    <span>期间：<t t-out="data.get('date_from', '')" t-options='{"widget": "date"}'/> 至 <t t-out="data.get('date_to', '')" t-options='{"widget": "date"}'/></span>
                </div>
            </div>

            <!-- 筛选条件 -->
            <div style="margin-bottom: 10px; font-size: 11px;">
                <t t-if="data.get('category_id')">
                    <span>资产类别：<t t-out="env['account.asset.category'].browse(data['category_id']).name"/></span>
                </t>
                <t t-else="">
                    <span>资产类别：全部</span>
                </t>
            </div>

            <!-- 计算数据 -->
            <t t-set="date_from" t-value="data.get('date_from')"/>
            <t t-set="date_to" t-value="data.get('date_to')"/>
            <t t-set="company_id" t-value="data.get('company_id', company.id)"/>
            <t t-set="category_id" t-value="data.get('category_id')"/>

            <!-- 期初资产（期间开始前已存在的资产） -->
            <t t-set="opening_assets" t-value="env['account.asset.asset'].search([
                ('type', '=', 'purchase'),
                ('state', 'in', ['open', 'paused', 'close']),
                ('company_id', '=', company_id),
                ('date', '&lt;', date_from),
                ('category_id', '=', category_id) if category_id else (1, '=', 1)
            ])"/>

            <!-- 本期增加资产（期间内创建的资产） -->
            <t t-set="addition_assets" t-value="env['account.asset.asset'].search([
                ('type', '=', 'purchase'),
                ('state', 'in', ['open', 'paused', 'close']),
                ('company_id', '=', company_id),
                ('date', '&gt;=', date_from),
                ('date', '&lt;=', date_to),
                ('category_id', '=', category_id) if category_id else (1, '=', 1)
            ])"/>

            <!-- 本期减少资产（期间内处置的资产） -->
            <t t-set="disposal_assets" t-value="env['account.asset.asset'].search([
                ('type', '=', 'purchase'),
                ('state', '=', 'close'),
                ('company_id', '=', company_id),
                ('category_id', '=', category_id) if category_id else (1, '=', 1)
            ]).filtered(lambda a: any(
                l.move_id and l.move_id.date &gt;= date_from and l.move_id.date &lt;= date_to
                for l in a.depreciation_line_ids
                if '处置' in (l.name or '') or '报废' in (l.name or '') or '出售' in (l.name or '')
            ))"/>

            <!-- 期末资产 = 期初 + 本期增加 - 本期减少 -->
            <t t-set="closing_assets" t-value="opening_assets | addition_assets"/>

            <!-- 汇总信息 -->
            <div style="margin-bottom: 10px;">
                <table class="table table-sm table-bordered" style="margin-bottom: 0;">
                    <thead>
                        <tr style="background-color: #f5f5f5;">
                            <th class="text-center" style="width: 16%;">项目</th>
                            <th class="text-center" style="width: 14%;">资产数量</th>
                            <th class="text-center" style="width: 18%;">原值</th>
                            <th class="text-center" style="width: 18%;">累计折旧</th>
                            <th class="text-center" style="width: 18%;">净值</th>
                            <th class="text-center" style="width: 16%;">备注</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- 期初数 -->
                        <tr>
                            <td class="text-center" style="font-weight: bold;">一、期初数</td>
                            <td class="text-center"><t t-out="len(opening_assets)"/></td>
                            <td class="text-end">
                                <t t-set="opening_value" t-value="sum(a.value for a in opening_assets)"/>
                                <t t-out="opening_value" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-end">
                                <t t-set="opening_accumulated" t-value="sum(sum(l.amount for l in a.depreciation_line_ids if l.move_posted_check and l.depreciation_date &lt; date_from) for a in opening_assets)"/>
                                <t t-out="opening_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-end">
                                <t t-out="opening_value - opening_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-center">-</td>
                        </tr>
                        <!-- 本期增加 -->
                        <tr>
                            <td class="text-center" style="font-weight: bold;">二、本期增加</td>
                            <td class="text-center"><t t-out="len(addition_assets)"/></td>
                            <td class="text-end">
                                <t t-set="addition_value" t-value="sum(a.value for a in addition_assets)"/>
                                <t t-out="addition_value" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-end">
                                <t t-set="addition_accumulated" t-value="sum(sum(l.amount for l in a.depreciation_line_ids if l.move_posted_check) for a in addition_assets)"/>
                                <t t-out="addition_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-end">
                                <t t-out="addition_value - addition_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-center">购入/新建</td>
                        </tr>
                        <!-- 本期减少 -->
                        <tr>
                            <td class="text-center" style="font-weight: bold;">三、本期减少</td>
                            <td class="text-center"><t t-out="len(disposal_assets)"/></td>
                            <td class="text-end">
                                <t t-set="disposal_value" t-value="sum(a.value for a in disposal_assets)"/>
                                <t t-out="disposal_value" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-end">
                                <t t-set="disposal_accumulated" t-value="sum(sum(l.amount for l in a.depreciation_line_ids if l.move_posted_check) for a in disposal_assets)"/>
                                <t t-out="disposal_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-end">
                                <t t-out="disposal_value - disposal_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-center">处置/报废</td>
                        </tr>
                        <!-- 期末数 -->
                        <tr style="font-weight: bold; background-color: #f9f9f9;">
                            <td class="text-center">四、期末数</td>
                            <td class="text-center"><t t-out="len(closing_assets)"/></td>
                            <td class="text-end">
                                <t t-set="closing_value" t-value="opening_value + addition_value - disposal_value"/>
                                <t t-out="closing_value" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-end">
                                <t t-set="closing_accumulated" t-value="opening_accumulated + addition_accumulated - disposal_accumulated"/>
                                <t t-out="closing_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-end">
                                <t t-out="closing_value - closing_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            <td class="text-center">-</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- 明细表 -->
            <div style="margin-top: 15px;">
                <div style="font-weight: bold; margin-bottom: 5px; font-size: 12px;">资产明细</div>
                <table class="table table-sm table-bordered" style="font-size: 10px;">
                    <thead>
                        <tr style="background-color: #f5f5f5;">
                            <th class="text-center" style="width: 5%;">序号</th>
                            <th class="text-center" style="width: 10%;">资产编号</th>
                            <th class="text-center" style="width: 15%;">资产名称</th>
                            <th class="text-center" style="width: 10%;">资产类别</th>
                            <th class="text-center" style="width: 8%;">变动类型</th>
                            <th class="text-center" style="width: 10%;">原值</th>
                            <th class="text-center" style="width: 10%;">累计折旧</th>
                            <th class="text-center" style="width: 10%;">净值</th>
                            <th class="text-center" style="width: 10%;">购置日期</th>
                            <th class="text-center" style="width: 12%;">变动日期</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="seq" t-value="0"/>
                        <!-- 期初资产明细 -->
                        <t t-foreach="opening_assets" t-as="asset">
                            <t t-set="seq" t-value="seq + 1"/>
                            <t t-set="asset_accumulated" t-value="sum(l.amount for l in asset.depreciation_line_ids if l.move_posted_check and l.depreciation_date &lt; date_from)"/>
                            <tr>
                                <td class="text-center"><t t-out="seq"/></td>
                                <td class="text-center"><t t-out="asset.code or ''"/></td>
                                <td><t t-out="asset.name"/></td>
                                <td><t t-out="asset.category_id.name or ''"/></td>
                                <td class="text-center" style="color: #666;">期初</td>
                                <td class="text-end">
                                    <t t-out="asset.value" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-end">
                                    <t t-out="asset_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-end">
                                    <t t-out="asset.value - asset_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-center">
                                    <t t-out="asset.date" t-options='{"widget": "date"}'/>
                                </td>
                                <td class="text-center">-</td>
                            </tr>
                        </t>
                        <!-- 本期增加资产明细 -->
                        <t t-foreach="addition_assets" t-as="asset">
                            <t t-set="seq" t-value="seq + 1"/>
                            <t t-set="asset_accumulated" t-value="sum(l.amount for l in asset.depreciation_line_ids if l.move_posted_check)"/>
                            <tr style="background-color: #e8f5e9;">
                                <td class="text-center"><t t-out="seq"/></td>
                                <td class="text-center"><t t-out="asset.code or ''"/></td>
                                <td><t t-out="asset.name"/></td>
                                <td><t t-out="asset.category_id.name or ''"/></td>
                                <td class="text-center" style="color: green;">增加</td>
                                <td class="text-end">
                                    <t t-out="asset.value" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-end">
                                    <t t-out="asset_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-end">
                                    <t t-out="asset.value - asset_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-center">
                                    <t t-out="asset.date" t-options='{"widget": "date"}'/>
                                </td>
                                <td class="text-center">
                                    <t t-out="asset.date" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                        </t>
                        <!-- 本期减少资产明细 -->
                        <t t-foreach="disposal_assets" t-as="asset">
                            <t t-set="seq" t-value="seq + 1"/>
                            <t t-set="asset_accumulated" t-value="sum(l.amount for l in asset.depreciation_line_ids if l.move_posted_check)"/>
                            <tr style="background-color: #ffebee;">
                                <td class="text-center"><t t-out="seq"/></td>
                                <td class="text-center"><t t-out="asset.code or ''"/></td>
                                <td><t t-out="asset.name"/></td>
                                <td><t t-out="asset.category_id.name or ''"/></td>
                                <td class="text-center" style="color: red;">减少</td>
                                <td class="text-end">
                                    <t t-out="asset.value" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-end">
                                    <t t-out="asset_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-end">
                                    <t t-out="asset.value - asset_accumulated" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-center">
                                    <t t-out="asset.date" t-options='{"widget": "date"}'/>
                                </td>
                                <td class="text-center">
                                    <t t-out="asset.date" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                        </t>
                        <!-- 空行补齐（至少显示 8 行） -->
                        <t t-set="total_count" t-value="len(opening_assets) + len(addition_assets) + len(disposal_assets)"/>
                        <t t-foreach="range(max(0, 8 - total_count))" t-as="i">
                            <tr>
                                <td style="height: 20px;"> </td>
                                <td> </td>
                                <td> </td>
                                <td> </td>
                                <td> </td>
                                <td> </td>
                                <td> </td>
                                <td> </td>
                                <td> </td>
                                <td> </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- 签章栏 -->
            <div class="row" style="margin-top: 20px; font-size: 11px; border-top: 1px solid #000; padding-top: 8px;">
                <div class="col-3 text-center">
                    <span>制表人：<u style="display: inline-block; width: 60px;"> </u></span>
                </div>
                <div class="col-3 text-center">
                    <span>审核人：<u style="display: inline-block; width: 60px;"> </u></span>
                </div>
                <div class="col-3 text-center">
                    <span>财务主管：<u style="display: inline-block; width: 60px;"> </u></span>
                </div>
                <div class="col-3 text-center">
                    <span>日期：<u style="display: inline-block; width: 80px;"> </u></span>
                </div>
            </div>
        </div>
    </template>

    <template id="report_asset_change">
        <t t-call="web.html_container">
            <t t-call="tour_accounting.report_asset_change_document"/>
        </t>
    </template>
</odoo>
