<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_commission_search" model="ir.ui.view">
        <field name="name">tour.commission.search</field>
        <field name="model">tour.commission</field>
        <field name="arch" type="xml">
            <search string="佣金搜索">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="plan_code"/>
                <field name="shop_id"/>
                <field name="guide_id"/>
                <field name="guide_tax_type"/>
                <separator/>
                <filter name="group_state" string="状态" context="{'group_by':'state'}"/>
                <filter name="group_shop" string="购物店" context="{'group_by':'shop_id'}"/>
                <filter name="group_guide" string="导游" context="{'group_by':'guide_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_tour_commission" model="ir.actions.act_window">
        <field name="name">佣金</field>
        <field name="res_model">tour.commission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tour_commission_search"/>
    </record>

    <record id="view_tour_commission_list" model="ir.ui.view">
        <field name="name">tour.commission.list</field>
        <field name="model">tour.commission</field>
        <field name="arch" type="xml">
            <list string="佣金">
                <field name="name"/>
                <field name="plan_code"/>
                <field name="shop_id"/>
                <field name="commission_total"/>
                <field name="guide_id"/>
                <field name="guide_share_before_tax"/>
                <field name="guide_tax"/>
                <field name="guide_net_pay"/>
                <field name="company_retain"/>
                <field name="state" widget="badge" decoration-success="state=='received'" decoration-info="state=='confirmed'" decoration-warning="state=='draft'"/>
            </list>
        </field>
    </record>

    <record id="view_tour_commission_form" model="ir.ui.view">
        <field name="name">tour.commission.form</field>
        <field name="model">tour.commission</field>
        <field name="arch" type="xml">
            <form string="佣金">
                <header>
                    <button name="action_confirm" string="确认" type="object" class="btn-primary"
                        invisible="state != 'draft'"/>
                    <button name="action_receive" string="收款" type="object"
                        invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="佣金编号"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="plan_code"/>
                            <field name="shop_id"/>
                            <field name="shop_name"/>
                            <field name="agreement_id"/>
                        </group>
                        <group>
                            <field name="commission_rate"/>
                            <field name="shop_amount"/>
                            <field name="commission_total"/>
                        </group>
                    </group>
                    <group string="导游分成">
                        <field name="guide_id"/>
                        <field name="guide_share_rate"/>
                        <field name="guide_share_before_tax"/>
                        <field name="premium"/>
                    </group>
                    <group string="个税代扣（劳务报酬 20%-40%）">
                        <field name="guide_tax_type"/>
                        <field name="guide_tax"/>
                        <field name="guide_net_pay"/>
                        <field name="company_retain"/>
                    </group>
                    <group string="归属">
                        <field name="company_id"/>
                        <field name="department_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
