<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_tour_pay_channel" model="ir.actions.act_window">
        <field name="name">支付渠道</field>
        <field name="res_model">tour.pay.channel</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tour_pay_channel_list" model="ir.ui.view">
        <field name="name">tour.pay.channel.list</field>
        <field name="model">tour.pay.channel</field>
        <field name="arch" type="xml">
            <list string="支付渠道">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="channel_type"/>
                <field name="fund_account_code"/>
                <field name="fund_account_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tour_pay_channel_form" model="ir.ui.view">
        <field name="name">tour.pay.channel.form</field>
        <field name="model">tour.pay.channel</field>
        <field name="arch" type="xml">
            <form string="支付渠道">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="channel_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="fund_account_code"/>
                            <field name="fund_account_name"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="摘要">
                        <field name="brief"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
