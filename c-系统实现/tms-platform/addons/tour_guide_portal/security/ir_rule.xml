<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 导游门户：只能看自己的数据 -->

    <!-- tour.guide: portal 用户只能看关联自己 partner 的导游 -->
    <record id="rule_guide_portal" model="ir.rule">
        <field name="name">tour.guide: portal user sees own guide</field>
        <field name="model_id" ref="tour_resource.model_tour_guide"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- tour.commission: portal 用户只能看自己的佣金 -->
    <record id="rule_commission_portal" model="ir.rule">
        <field name="name">tour.commission: portal user sees own commissions</field>
        <field name="model_id" ref="tour_accounting.model_tour_commission"/>
        <field name="domain_force">[('guide_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- tour.guide.loan: portal 用户只能看自己的借款 -->
    <record id="rule_loan_portal" model="ir.rule">
        <field name="name">tour.guide.loan: portal user sees own loans</field>
        <field name="model_id" ref="tour_accounting.model_tour_guide_loan"/>
        <field name="domain_force">['|',
            ('guide_id.partner_id', '=', user.partner_id.id),
            ('employee_id.user_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- hr.expense: portal 用户只能看自己的报账，可创建 -->
    <record id="rule_expense_portal" model="ir.rule">
        <field name="name">hr.expense: portal user sees own expenses</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="domain_force">['|',
            ('x_guide_id.partner_id', '=', user.partner_id.id),
            ('employee_id.user_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ir.attachment: portal 用户只能访问自己报账的附件 -->
    <record id="rule_attachment_portal" model="ir.rule">
        <field name="name">ir.attachment: portal user sees own expense attachments</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">[
            ('res_model', '=', 'hr.expense'),
            ('res_id', 'in', user.partner_id.id and env['hr.expense'].sudo()._search(['|',
                ('x_guide_id.partner_id', '=', user.partner_id.id),
                ('employee_id.user_id.partner_id', '=', user.partner_id.id)]) or [])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- project.task: portal 用户只能看自己的派团 -->
    <record id="rule_task_portal" model="ir.rule">
        <field name="name">project.task: portal user sees own dispatches</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[
            ('resource_type', '=', 'guide'),
            ('guide_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- tour.plan: portal 用户只能看自己参与的团 -->
    <record id="rule_plan_portal" model="ir.rule">
        <field name="name">tour.plan: portal user sees own plans</field>
        <field name="model_id" ref="tour_order.model_tour_plan"/>
        <field name="domain_force">[('guide_ids', 'in', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
