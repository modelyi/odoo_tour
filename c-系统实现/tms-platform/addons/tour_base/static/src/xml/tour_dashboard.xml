<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tour_base.TourDashboard">
        <div class="o_tour_dashboard">
            <t t-if="state.loading">
                <div class="o_dashboard_loading">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                    <p>加载中...</p>
                </div>
            </t>
            <t t-else="">
                <!-- Section 1: Tour States -->
                <div class="o_dashboard_section" t-if="state.data.tour_states.length > 0">
                    <h3 class="o_dashboard_title">团队状态概览</h3>
                    <div class="o_dashboard_cards">
                        <t t-foreach="state.data.tour_states" t-as="item" t-key="item.state">
                            <div class="o_dashboard_card o_card_tour"
                                 t-on-click="() => this.navigateToTours(item.state)">
                                <span class="o_card_count"><t t-esc="item.count"/></span>
                                <span class="o_card_label"><t t-esc="item.label"/></span>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Section 2: Pending Bookings -->
                <div class="o_dashboard_section" t-if="state.data.pending_bookings.length > 0">
                    <h3 class="o_dashboard_title">待确认预订</h3>
                    <div class="o_dashboard_cards">
                        <t t-foreach="state.data.pending_bookings" t-as="item" t-key="item.type">
                            <div class="o_dashboard_card o_card_booking"
                                 t-on-click="() => this.navigateToBookings(item.type)">
                                <span class="o_card_count"><t t-esc="item.count"/></span>
                                <span class="o_card_label"><t t-esc="item.label"/></span>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Section 3: Financial Pending -->
                <div class="o_dashboard_section">
                    <h3 class="o_dashboard_title">待处理财务</h3>
                    <div class="o_dashboard_cards">
                        <t t-foreach="state.data.financial_pending.pay_requests" t-as="item" t-key="'pr'">
                            <div class="o_dashboard_card o_card_finance"
                                 t-on-click="() => this.navigateToPayRequests()">
                                <span class="o_card_count"><t t-esc="item.count"/></span>
                                <span class="o_card_label"><t t-esc="item.label"/></span>
                                <span class="o_card_amount" t-if="item.amount">
                                    <t t-esc="this.formatAmount(item.amount)"/>
                                </span>
                            </div>
                        </t>
                        <t t-foreach="state.data.financial_pending.claims" t-as="item" t-key="'cl'">
                            <div class="o_dashboard_card o_card_finance"
                                 t-on-click="() => this.navigateToClaims()">
                                <span class="o_card_count"><t t-esc="item.count"/></span>
                                <span class="o_card_label"><t t-esc="item.label"/></span>
                            </div>
                        </t>
                        <div class="o_dashboard_card o_card_empty"
                             t-if="state.data.financial_pending.pay_requests.length === 0 and state.data.financial_pending.claims.length === 0">
                            <span class="o_card_label">暂无待处理事项</span>
                        </div>
                    </div>
                </div>

                <!-- Section 4: Quick Navigation -->
                <div class="o_dashboard_section">
                    <h3 class="o_dashboard_title">快捷入口</h3>
                    <div class="o_dashboard_cards">
                        <div class="o_dashboard_card o_card_nav" t-on-click="() => this.navigateToTours('all')">
                            <i class="fa fa-list-alt fa-2x"/>
                            <span class="o_card_label">团队订单</span>
                        </div>
                        <div class="o_dashboard_card o_card_nav" t-on-click="() => this.navigateToKanban()">
                            <i class="fa fa-th-large fa-2x"/>
                            <span class="o_card_label">计调看板</span>
                        </div>
                        <div class="o_dashboard_card o_card_nav" t-on-click="() => this.navigateToPayRequests()">
                            <i class="fa fa-money fa-2x"/>
                            <span class="o_card_label">请款单</span>
                        </div>
                        <div class="o_dashboard_card o_card_nav" t-on-click="() => this.navigateToClaims()">
                            <i class="fa fa-check-circle fa-2x"/>
                            <span class="o_card_label">收款认领</span>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
