<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 根菜单：旅行社管理（所有 tour_* 业务模块菜单统一挂载于此） -->
    <menuitem id="menu_tms_root"
        name="旅行社管理"
        web_icon="tour_base,static/description/icon.png"
        sequence="10"/>

    <!-- ================================================================
         待实施功能：占位菜单 + 占位 act_url（仅超级用户可见，不实现业务逻辑）
         点击跳 tour_tutor 的 /tutor/pending 提示页（按 ?name= 区分功能名）。
         注意：act_url 统一挂在 tour_base（菜单所在模块），避免跨模块反向依赖；
         /tutor/pending 路由本身由 tour_tutor 提供（tour_tutor depends tour_base）。
    ================================================================ -->
    <record id="action_tms_pending" model="ir.actions.act_url">
        <field name="name">待实施功能</field>
        <field name="url">/tutor/pending?name=待实施功能</field>
        <field name="target">self</field>
    </record>
