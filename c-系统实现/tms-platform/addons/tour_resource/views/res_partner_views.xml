<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form: 在联系人表单中新增「供应商信息」页签 -->
    <record id="view_res_partner_supplier_form" model="ir.ui.view">
        <field name="name">res.partner.supplier.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="供应商信息" name="tour_supplier">
                    <group string="供应商类型与基本信息">
                        <group>
                            <field name="sup_type"/>
                            <field name="et_cmp_code"/>
                            <field name="help_code"/>
                            <field name="manager"/>
                            <field name="manager_mobile"/>
                            <field name="manager_id_code"/>
                            <field name="boss_birthday"/>
                        </group>
                        <group>
                            <field name="grade"/>
                            <field name="level_id"/>
                            <field name="level_name"/>
                            <field name="sort_code"/>
                            <field name="verify_user"/>
                            <field name="purchaser"/>
                            <field name="grant_num"/>
                            <field name="author_date"/>
                        </group>
                    </group>
                    <group string="合同与开票">
                        <group>
                            <field name="contract_no"/>
                            <field name="contract_date"/>
                            <field name="contract_begin_date"/>
                            <field name="contract_end_date"/>
                            <field name="is_contract"/>
                        </group>
                        <group>
                            <field name="invoice_title"/>
                            <field name="tax_payer_no"/>
                            <field name="is_invoice"/>
                            <field name="invoice_rule"/>
                        </group>
                    </group>
                    <group string="等级与信用额度">
                        <group>
                            <field name="credit_lmt"/>
                            <field name="credit_lmt_type"/>
                            <field name="credit_lmt_sk"/>
                        </group>
                        <group>
                            <field name="charge_period"/>
                            <field name="free_payment_lmt"/>
                            <field name="pay_way"/>
                        </group>
                    </group>
                    <group string="协议价与服务费">
                        <group>
                            <field name="agr_price"/>
                            <field name="any_price"/>
                            <field name="service_type"/>
                            <field name="service_price"/>
                        </group>
                        <group>
                            <field name="service_calc_mode"/>
                            <field name="service_fee_round_way"/>
                            <field name="cooperation_agreement"/>
                        </group>
                    </group>
                    <group string="区域信息">
                        <group>
                            <field name="province"/>
                            <field name="city_name"/>
                            <field name="zone"/>
                            <field name="county_town"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longtitue"/>
                            <field name="location"/>
                            <field name="addr2"/>
                            <field name="manage_area_set"/>
                        </group>
                    </group>
                    <group string="结算与账号">
                        <group>
                            <field name="bank"/>
                            <field name="account"/>
                            <field name="account_no"/>
                        </group>
                        <group>
                            <field name="res_isolation"/>
                            <field name="isno_repeat"/>
                        </group>
                    </group>
                    <group string="审核与备注">
                        <group>
                            <field name="audit_chk"/>
                            <field name="audit_user"/>
                            <field name="audit_date"/>
                        </group>
                        <group>
                            <field name="audit_brief"/>
                            <field name="remark"/>
                            <field name="remark2"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- List: 供应商专用列表（含 sup_type 列） -->
    <record id="view_res_partner_supplier_list" model="ir.ui.view">
        <field name="name">res.partner.supplier.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="供应商">
                <field name="name"/>
                <field name="sup_type"/>
                <field name="manager"/>
                <field name="manager_mobile"/>
                <field name="phone"/>
                <field name="city_name"/>
                <field name="grade"/>
                <field name="credit_lmt"/>
                <field name="audit_chk"/>
            </list>
        </field>
    </record>

    <!-- Search: 供应商类型筛选 -->
    <record id="view_res_partner_supplier_search" model="ir.ui.view">
        <field name="name">res.partner.supplier.search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="group_sup_type" string="供应商类型" context="{'group_by':'sup_type'}"/>
                <separator/>
                <filter name="sup_customer" string="客户" domain="[('sup_type','=','customer')]"/>
                <filter name="sup_ditch" string="地接社" domain="[('sup_type','=','ditch')]"/>
                <filter name="sup_hotel" string="酒店" domain="[('sup_type','=','hotel')]"/>
                <filter name="sup_meal" string="餐厅" domain="[('sup_type','=','meal')]"/>
                <filter name="sup_vehicle_comp" string="车队" domain="[('sup_type','=','vehicle_comp')]"/>
                <filter name="sup_ticket" string="票务" domain="[('sup_type','=','ticket')]"/>
                <filter name="sup_scenic" string="景区" domain="[('sup_type','=','scenic')]"/>
                <filter name="sup_shop" string="购物店" domain="[('sup_type','=','shop')]"/>
                <filter name="sup_insurance" string="保险" domain="[('sup_type','=','insurance')]"/>
                <filter name="sup_self_fee" string="自费" domain="[('sup_type','=','self_fee')]"/>
            </xpath>
        </field>
    </record>

    <!-- Action: 供应商 -->
    <record id="action_tour_supplier" model="ir.actions.act_window">
        <field name="name">供应商</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_res_partner_supplier_list"/>
        <field name="search_view_id" ref="view_res_partner_supplier_search"/>
        <field name="domain">[('sup_type', '!=', False)]</field>
        <field name="context">{'default_is_company': True}</field>
    </record>
</odoo>
