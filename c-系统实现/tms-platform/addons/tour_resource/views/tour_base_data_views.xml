<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 区域：列表视图 -->
    <record id="view_tour_region_list" model="ir.ui.view">
        <field name="name">tour.region.list</field>
        <field name="model">tour.region</field>
        <field name="arch" type="xml">
            <list string="区域" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="region_type"/>
                <field name="parent_id"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- 区域：表单视图 -->
    <record id="view_tour_region_form" model="ir.ui.view">
        <field name="name">tour.region.form</field>
        <field name="model">tour.region</field>
        <field name="arch" type="xml">
            <form string="区域">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="region_type"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="remark"/>
                    </group>
                    <notebook>
                        <page string="下级区域" name="children">
                            <field name="child_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="region_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 区域：搜索视图 -->
    <record id="view_tour_region_search" model="ir.ui.view">
        <field name="name">tour.region.search</field>
        <field name="model">tour.region</field>
        <field name="arch" type="xml">
            <search string="搜索区域">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="region_type"/>
                <field name="parent_id"/>
                <filter name="inactive" string="已归档" domain="[('active', '=', False)]"/>
                <group expand="0" string="分组">
                    <filter name="group_type" string="区域类型" context="{'group_by': 'region_type'}"/>
                    <filter name="group_parent" string="上级区域" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 区域：Action -->
    <record id="action_tour_region" model="ir.actions.act_window">
        <field name="name">区域维护</field>
        <field name="res_model">tour.region</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tour_region_search"/>
    </record>

    <!-- 结算方式：列表视图 -->
    <record id="view_tour_settlement_method_list" model="ir.ui.view">
        <field name="name">tour.settlement.method.list</field>
        <field name="model">tour.settlement.method</field>
        <field name="arch" type="xml">
            <list string="结算方式" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="settlement_type"/>
                <field name="days_due"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- 结算方式：表单视图 -->
    <record id="view_tour_settlement_method_form" model="ir.ui.view">
        <field name="name">tour.settlement.method.form</field>
        <field name="model">tour.settlement.method</field>
        <field name="arch" type="xml">
            <form string="结算方式">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="settlement_type"/>
                        </group>
                        <group>
                            <field name="days_due"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="remark"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 结算方式：Action -->
    <record id="action_tour_settlement_method" model="ir.actions.act_window">
        <field name="name">结算方式</field>
        <field name="res_model">tour.settlement.method</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
