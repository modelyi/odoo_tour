<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 订单管理顶级菜单（挂在 tour_product 的「旅行社管理」根菜单下） -->
    <menuitem id="menu_tms_order"
        name="订单管理"
        parent="tour_base.menu_tms_root"
        sequence="20"
        groups="tour_base.group_tour_operator,tour_base.group_tour_finance,tour_base.group_tour_sales"/>

    <!-- 团队订单（按分类拆分子菜单） -->
    <menuitem id="menu_tour_plan"
        name="团队订单"
        parent="menu_tms_order"
        sequence="10"/>

    <menuitem id="menu_tour_plan_regular"
        name="常规旅游团"
        parent="menu_tour_plan"
        action="action_tour_plan_regular"
        sequence="10"/>

    <menuitem id="menu_tour_plan_fit"
        name="散客计划"
        parent="menu_tour_plan"
        action="action_tour_plan_fit"
        sequence="20"/>

    <menuitem id="menu_tour_plan_independent"
        name="自由行"
        parent="menu_tour_plan"
        action="action_tour_plan_independent"
        sequence="30"/>

    <menuitem id="menu_tour_plan_booking"
        name="代订"
        parent="menu_tour_plan"
        action="action_tour_plan_booking"
        sequence="40"/>

    <menuitem id="menu_tour_plan_all"
        name="全部订单"
        parent="menu_tour_plan"
        action="action_tour_plan"
        sequence="90"/>

    <menuitem id="menu_tour_plan_reg"
        name="报名"
        parent="menu_tms_order"
        action="action_tour_plan_reg"
        sequence="20"/>

    <menuitem id="menu_tour_merge"
        name="并团"
        parent="menu_tms_order"
        action="action_tour_merge"
        sequence="30"/>

    <menuitem id="menu_tour_plan_change"
        name="单团变更"
        parent="menu_tms_order"
        action="action_tour_plan_change"
        sequence="40"/>

    <!-- 订单配置（Odoo 惯例：配置菜单放最后） -->
    <menuitem id="menu_tms_order_config"
        name="配置"
        parent="menu_tms_order"
        sequence="90"/>
</odoo>
