<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 计调强制安排权限组 -->
    <record id="group_tour_operation_force_assign" model="res.groups">
        <field name="name">计调强制安排</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 营运中心二次确认权限组 -->
    <record id="group_tour_operation_confirm" model="res.groups">
        <field name="name">营运中心二次确认</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 计调角色隐含 project 用户组：让计调看到项目菜单并能读写 project.task -->
    <record id="tour_base.group_tour_operator" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <!-- 预订任务记录规则：按公司隔离 -->
    <record id="rule_project_task_company" model="ir.rule">
        <field name="name">预订任务：公司隔离</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('tour_base.group_tour_operator'))]"/>
    </record>
</odoo>
