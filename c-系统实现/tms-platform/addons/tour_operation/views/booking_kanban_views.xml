<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 计调看板视图：按团显示 5 类资源安排状态与进度 -->
    <record id="view_tour_plan_booking_kanban" model="ir.ui.view">
        <field name="name">tour.plan.booking.kanban</field>
        <field name="model">tour.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="plan_code"/>
                <field name="plan_name"/>
                <field name="begin_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <field name="booking_guide_count"/>
                <field name="booking_vehicle_count"/>
                <field name="booking_hotel_count"/>
                <field name="booking_meal_count"/>
                <field name="booking_scenic_count"/>
                <field name="booking_insurance_count"/>
                <field name="booking_ditch_count"/>
                <field name="booking_completed_count"/>
                <field name="booking_total_count"/>
                <field name="booking_progress"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="plan_code"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="plan_name"/>
                                    </div>
                                </div>
                                <field name="state" widget="label_selection"
                                    options="{'classes': {'confirmed': 'success', 'operating': 'info', 'in_progress': 'warning'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <small>出发：<field name="begin_date"/></small>
                                    </div>
                                    <div class="col-6">
                                        <small>返回：<field name="end_date"/></small>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-4 text-center">
                                        <span class="badge badge-info">
                                            导 <field name="booking_guide_count"/>
                                        </span>
                                    </div>
                                    <div class="col-4 text-center">
                                        <span class="badge badge-info">
                                            车 <field name="booking_vehicle_count"/>
                                        </span>
                                    </div>
                                    <div class="col-4 text-center">
                                        <span class="badge badge-info">
                                            房 <field name="booking_hotel_count"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col-4 text-center">
                                        <span class="badge badge-info">
                                            餐 <field name="booking_meal_count"/>
                                        </span>
                                    </div>
                                    <div class="col-4 text-center">
                                        <span class="badge badge-info">
                                            票 <field name="booking_scenic_count"/>
                                        </span>
                                    </div>
                                    <div class="col-4 text-center">
                                        <span class="badge badge-info">
                                            险 <field name="booking_insurance_count"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col-12 text-center">
                                        <span class="badge badge-info">
                                            地接 <field name="booking_ditch_count"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="progress mt-2" style="height: 20px;">
                                    <div class="progress-bar bg-success" role="progressbar"
                                        t-att-style="'width: ' + record.booking_progress.raw_value + '%'"
                                        t-att-aria-valuenow="record.booking_progress.raw_value"
                                        aria-valuemin="0" aria-valuemax="100">
                                        <field name="booking_progress" widget="float"/>%
                                    </div>
                                </div>
                                <small class="text-muted">
                                    已完成 <field name="booking_completed_count"/> / <field name="booking_total_count"/>
                                </small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 计调看板 Action -->
    <record id="action_tour_plan_booking_kanban" model="ir.actions.act_window">
        <field name="name">计调看板</field>
        <field name="res_model">tour.plan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_tour_plan_booking_kanban')}),
            (0, 0, {'view_mode': 'list'}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="domain">[('state', 'in', ('confirmed', 'operating', 'in_progress'))]</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>
</odoo>
