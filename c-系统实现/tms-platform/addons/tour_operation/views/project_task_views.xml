<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View（先定义，供 action 引用） -->
    <record id="view_project_task_booking_search" model="ir.ui.view">
        <field name="name">project.task.booking.search</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search string="预订安排搜索">
                <field name="name"/>
                <field name="project_id"/>
                <field name="plan_code"/>
                <field name="guide_id"/>
                <field name="vehicle_id"/>
                <field name="supplier_id"/>
                <field name="date_start"/>
                <field name="date_deadline"/>
                <separator/>
                <filter name="group_resource_type" string="资源类型" context="{'group_by':'resource_type'}"/>
                <filter name="group_stage" string="阶段" context="{'group_by':'stage_id'}"/>
                <separator/>
                <filter name="type_guide" string="派导" domain="[('resource_type','=','guide')]"/>
                <filter name="type_vehicle" string="派车" domain="[('resource_type','=','vehicle')]"/>
                <filter name="type_hotel" string="订房" domain="[('resource_type','=','hotel')]"/>
                <filter name="type_meal" string="订餐" domain="[('resource_type','=','meal')]"/>
                <filter name="type_scenic" string="门票" domain="[('resource_type','=','scenic')]"/>
                <filter name="type_insurance" string="保险" domain="[('resource_type','=','insurance')]"/>
                <filter name="type_ditch" string="地接" domain="[('resource_type','=','ditch')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_project_task_booking" model="ir.actions.act_window">
        <field name="name">预订安排</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_project_task_booking_search"/>
        <field name="context">{'default_resource_type': 'guide'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                为团队订单创建资源预订（派导/派车/订房/订餐/门票）
            </p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_project_task_booking_list" model="ir.ui.view">
        <field name="name">project.task.booking.list</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list string="预订安排">
                <field name="booking_no"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="plan_code"/>
                <field name="resource_type"/>
                <field name="guide_id"/>
                <field name="vehicle_id"/>
                <field name="supplier_id"/>
                <field name="date_start"/>
                <field name="date_deadline"/>
                <field name="guest_count"/>
                <field name="amount_total" sum="金额合计"/>
                <field name="seat_warning" optional="hide"/>
                <field name="confirm_state" optional="hide"/>
                <field name="state" optional="hide" widget="badge"
                    decoration-success="state in ('03_approved','1_done')"
                    decoration-info="state=='01_in_progress'"
                    decoration-danger="state=='1_canceled'"/>
            </list>
        </field>
    </record>

    <!-- Calendar View：按日期查看资源占用，按资源类型分色 -->
    <record id="view_project_task_booking_calendar" model="ir.ui.view">
        <field name="name">project.task.booking.calendar</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <calendar string="预订日历" date_start="date_start" date_stop="date_deadline"
                color="resource_type" quick_create="0" event_limit="10">
                <field name="name"/>
                <field name="plan_code"/>
                <field name="resource_type"/>
                <field name="guide_id"/>
                <field name="vehicle_id"/>
                <field name="supplier_id"/>
                <field name="guest_count"/>
                <field name="amount_total"/>
            </calendar>
        </field>
    </record>

    <!-- Form View（薄扩展原生 project.task form：加计调预订页 + 头按钮） -->
    <record id="view_project_task_form_booking" model="ir.ui.view">
        <field name="name">project.task.form.booking</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_confirm" string="确认" type="object" class="btn-primary"
                    invisible="state != '01_in_progress'"/>
                <button name="action_complete" string="完成" type="object"
                    invisible="state != '03_approved'"/>
                <button name="action_cancel" string="取消" type="object"
                    invisible="state in ('1_done','1_canceled')"/>
                <button name="action_set_draft" string="恢复待安排" type="object"
                    invisible="state != '1_canceled'"/>
                <button name="action_force_assign" string="强制安排" type="object"
                    groups="tour_operation.group_tour_operation_force_assign"
                    confirm="确认强制安排？将记录操作人与时间留痕。"
                    invisible="not force_reason"/>
                <button name="action_confirm_resource" string="资源到位确认" type="object"
                    groups="tour_operation.group_tour_operation_confirm"
                    invisible="resource_type not in ('hotel','scenic') or confirm_state == 'confirmed'"/>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="resource_type"/>
                <field name="date_start"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="计调预订" name="tour_booking">
                    <group string="预订信息">
                        <group>
                            <field name="booking_no"/>
                            <field name="resource_type"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="plan_code"/>
                            <field name="date_start"/>
                            <field name="date_deadline"/>
                            <field name="guest_count"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="confirm_state" invisible="resource_type not in ('hotel','scenic')"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <group string="资源/供应商">
                        <group>
                            <field name="guide_id" invisible="resource_type != 'guide'"/>
                            <field name="vehicle_id" invisible="resource_type != 'vehicle'"/>
                            <field name="supplier_id" invisible="resource_type not in ('hotel','meal','scenic','vehicle','insurance','ditch')"/>
                            <field name="supplier_name" invisible="resource_type not in ('hotel','meal','scenic','vehicle','insurance','ditch')"/>
                        </group>
                    </group>
                    <group string="派导" invisible="resource_type != 'guide'">
                        <field name="guide_fee"/>
                    </group>
                    <group string="派车" invisible="resource_type != 'vehicle'">
                        <field name="car_fee"/>
                        <field name="seat_num"/>
                        <field name="seat_warning" widget="boolean_toggle" readonly="1"
                            invisible="not seat_warning"/>
                        <field name="pick_time"/>
                        <field name="pick_place"/>
                        <field name="drop_time"/>
                        <field name="drop_place"/>
                    </group>
                    <group string="订房" invisible="resource_type != 'hotel'">
                        <field name="night_num"/>
                        <field name="room_price"/>
                        <field name="room_single"/>
                        <field name="room_standard"/>
                        <field name="room_triangle"/>
                        <field name="room_accompany"/>
                        <field name="room_additional"/>
                    </group>
                    <group string="订餐" invisible="resource_type != 'meal'">
                        <field name="meal_type"/>
                        <field name="table_count"/>
                        <field name="price_per_table"/>
                    </group>
                    <group string="门票" invisible="resource_type != 'scenic'">
                        <field name="unit_price"/>
                        <field name="adult_num"/>
                        <field name="child_num"/>
                        <field name="old_man_num"/>
                        <field name="student_num"/>
                    </group>
                    <group string="保险" invisible="resource_type != 'insurance'">
                        <group>
                            <field name="insurance_type"/>
                            <field name="insured_count"/>
                            <field name="premium_per_person"/>
                        </group>
                        <group>
                            <field name="policy_no"/>
                        </group>
                    </group>
                    <group string="地接" invisible="resource_type != 'ditch'">
                        <group>
                            <field name="ditch_destination"/>
                            <field name="ditch_contact"/>
                            <field name="ditch_contact_phone"/>
                        </group>
                        <group>
                            <field name="ditch_cost_per_person"/>
                            <field name="ditch_scope"/>
                        </group>
                    </group>
                    <group string="强制与备注">
                        <group>
                            <field name="force_reason"/>
                            <field name="force_user_id"/>
                            <field name="force_date"/>
                        </group>
                        <group>
                            <field name="remark"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
