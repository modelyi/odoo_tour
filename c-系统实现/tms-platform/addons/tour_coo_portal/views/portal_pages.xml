<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- COO 门户首页 - 运营概览仪表盘                                    -->
    <!-- ============================================================ -->
    <template id="portal_coo_home" name="COO Portal Home">
        <t t-call="tour_coo_portal.portal_coo_layout">
            <div class="o_coo_home">
                <h3 class="mb-4">
                    <i class="fa fa-dashboard me-2"/>运营概览
                </h3>

                <!-- KPI 卡片 -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card text-white bg-primary">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="card-title">活跃团队</h6>
                                        <h2 class="mb-0 mt-2"><t t-esc="active_plan_count"/></h2>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-suitcase fa-3x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/coo/orders" class="text-white text-decoration-none">
                                    查看详情 <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-warning">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="card-title">待调度任务</h6>
                                        <h2 class="mb-0 mt-2"><t t-esc="pending_dispatch_count"/></h2>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-calendar fa-3x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/coo/dispatches" class="text-white text-decoration-none">
                                    查看详情 <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-info">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="card-title">7 日内出发</h6>
                                        <h2 class="mb-0 mt-2"><t t-esc="upcoming_7d_count"/></h2>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-plane fa-3x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/coo/orders?filterby=confirmed" class="text-white text-decoration-none">
                                    查看详情 <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-danger">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="card-title">待审批</h6>
                                        <h2 class="mb-0 mt-2"><t t-esc="pending_approval_count"/></h2>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-check-square fa-3x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/coo/approvals" class="text-white text-decoration-none">
                                    查看详情 <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 分布统计表 -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-bar-chart me-2"/>资源类型分布
                                </h5>
                            </div>
                            <div class="card-body">
                                <t t-if="resource_type_counts">
                                    <table class="table table-sm table-borderless mb-0">
                                        <thead>
                                            <tr>
                                                <th>资源类型</th>
                                                <th class="text-end">数量</th>
                                                <th class="text-end">占比</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="resource_type_counts.items()" t-as="item">
                                                <tr t-if="item[1]['count'] > 0">
                                                    <td><t t-esc="item[1]['label']"/></td>
                                                    <td class="text-end"><t t-esc="item[1]['count']"/></td>
                                                    <td class="text-end"><t t-esc="item[1]['percentage']"/>%</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted text-center mb-0">暂无待调度任务</p>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-pie-chart me-2"/>团队状态分布
                                </h5>
                            </div>
                            <div class="card-body">
                                <t t-if="tour_state_distribution">
                                    <table class="table table-sm table-borderless mb-0">
                                        <thead>
                                            <tr>
                                                <th>状态</th>
                                                <th class="text-end">数量</th>
                                                <th class="text-end">占比</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="tour_state_distribution.items()" t-as="item">
                                                <tr>
                                                    <td><t t-esc="item[1]['label']"/></td>
                                                    <td class="text-end"><t t-esc="item[1]['count']"/></td>
                                                    <td class="text-end"><t t-esc="item[1]['percentage']"/>%</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted text-center mb-0">暂无团队数据</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 即将出发 & 最近待审批 -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-plane me-2"/>即将出发
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="upcoming_departures">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>团号</th>
                                                <th>线路</th>
                                                <th>出发日期</th>
                                                <th class="text-end">人数</th>
                                                <th class="text-end">预订进度</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="upcoming_departures" t-as="plan">
                                                <tr>
                                                    <td><t t-esc="plan.plan_code"/></td>
                                                    <td><t t-esc="plan.line_id.name or '-'"/></td>
                                                    <td><t t-esc="plan.begin_date" t-options="{'widget': 'date'}"/></td>
                                                    <td class="text-end"><t t-esc="plan.guest_count"/></td>
                                                    <td class="text-end">
                                                        <div class="progress" style="height: 18px;">
                                                            <div class="progress-bar" role="progressbar"
                                                                 t-att-style="'width: %s%%' % plan.booking_progress"
                                                                 t-att-aria-valuenow="plan.booking_progress"
                                                                 aria-valuemin="0" aria-valuemax="100">
                                                                <t t-esc="'%.0f' % plan.booking_progress"/>%
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted text-center py-3 mb-0">暂无即将出发的团队</p>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-check-square me-2"/>最近待审批
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="pending_approvals">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>团号</th>
                                                <th>客户</th>
                                                <th>出发日期</th>
                                                <th>审核状态</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="pending_approvals" t-as="plan">
                                                <tr>
                                                    <td><t t-esc="plan.plan_code"/></td>
                                                    <td><t t-esc="plan.supplier_id.name or '-'"/></td>
                                                    <td><t t-esc="plan.begin_date" t-options="{'widget': 'date'}"/></td>
                                                    <td>
                                                        <span class="badge bg-warning">
                                                            <t t-esc="dict(plan._fields['operation_audit_state'].selection).get(plan.operation_audit_state)"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted text-center py-3 mb-0">暂无待审批团队</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- 订单管线                                                       -->
    <!-- ============================================================ -->
    <template id="portal_coo_orders" name="COO Order Pipeline">
        <t t-call="tour_coo_portal.portal_coo_layout">
            <div class="o_coo_orders">
                <h3 class="mb-3">
                    <i class="fa fa-line-chart me-2"/>订单管线
                </h3>
                <t t-call="portal.portal_searchbar"/>
                <t t-if="plans">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>团号</th>
                                <th>计划名称</th>
                                <th>客户</th>
                                <th>出发日期</th>
                                <th>返回日期</th>
                                <th class="text-end">人数</th>
                                <th class="text-end">收入报价</th>
                                <th>状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="plans" t-as="plan">
                                <tr>
                                    <td><t t-esc="plan.plan_code"/></td>
                                    <td><t t-esc="plan.line_id.name or '-'"/></td>
                                    <td><t t-esc="plan.supplier_id.name or '-'"/></td>
                                    <td><t t-esc="plan.begin_date" t-options="{'widget': 'date'}"/></td>
                                    <td><t t-esc="plan.end_date" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end"><t t-esc="plan.guest_count"/></td>
                                    <td class="text-end">¥ <t t-esc="'%.2f' % plan.in_com_quo_sum"/></td>
                                    <td>
                                        <span t-att-class="'badge ' + (plan.state == 'completed' and 'bg-success' or plan.state == 'in_progress' and 'bg-info' or plan.state == 'operating' and 'bg-warning' or plan.state == 'confirmed' and 'bg-primary' or 'bg-secondary')">
                                            <t t-esc="dict(plan._fields['state'].selection).get(plan.state)"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-call="portal.pager"/>
                </t>
                <t t-else="">
                    <div class="text-center text-muted py-5">
                        <i class="fa fa-inbox fa-3x mb-3"/>
                        <br/>
                        暂无订单数据
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- 资源调度看板                                                    -->
    <!-- ============================================================ -->
    <template id="portal_coo_dispatches" name="COO Resource Dispatch">
        <t t-call="tour_coo_portal.portal_coo_layout">
            <div class="o_coo_dispatches">
                <h3 class="mb-3">
                    <i class="fa fa-calendar me-2"/>资源调度
                </h3>

                <!-- 资源类型计数卡片 -->
                <div class="row mb-4">
                    <t t-foreach="resource_type_counts.items()" t-as="item">
                        <div class="col-md-12 col-sm-6 mb-2" style="flex: 0 0 14.28%; max-width: 14.28%;">
                            <div class="card text-center">
                                <div class="card-body py-2">
                                    <i t-att-class="'fa ' + item[1]['icon'] + ' fa-lg text-primary mb-1'"/>
                                    <div class="h4 mb-0"><t t-esc="item[1]['count']"/></div>
                                    <small class="text-muted"><t t-esc="item[1]['label']"/></small>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <t t-call="portal.portal_searchbar"/>
                <t t-if="tasks">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>预订编号</th>
                                <th>团号</th>
                                <th>资源类型</th>
                                <th>资源/供应商</th>
                                <th>开始时间</th>
                                <th>截止时间</th>
                                <th>状态</th>
                                <th>确认状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="tasks" t-as="task">
                                <tr>
                                    <td><t t-esc="task.booking_no or '-'"/></td>
                                    <td><t t-esc="task.plan_code or '-'"/></td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            <t t-esc="dict(task._fields['resource_type'].selection).get(task.resource_type)"/>
                                        </span>
                                    </td>
                                    <td>
                                        <t t-if="task.resource_type == 'guide' and task.guide_id">
                                            <t t-esc="task.guide_id.name"/>
                                        </t>
                                        <t t-elif="task.resource_type == 'vehicle' and task.vehicle_id">
                                            <t t-esc="task.vehicle_id.name"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="task.supplier_name or '-'"/>
                                        </t>
                                    </td>
                                    <td><t t-esc="task.date_start" t-options="{'widget': 'datetime'}" t-if="task.date_start"/><t t-else="">-</t></td>
                                    <td><t t-esc="task.date_deadline" t-options="{'widget': 'datetime'}" t-if="task.date_deadline"/><t t-else="">-</t></td>
                                    <td>
                                        <span t-att-class="'badge ' + (task.state == '1_done' and 'bg-success' or task.state == '03_approved' and 'bg-info' or task.state == '1_canceled' and 'bg-danger' or 'bg-warning')">
                                            <t t-esc="dict(task._fields['state'].selection).get(task.state)"/>
                                        </span>
                                    </td>
                                    <td>
                                        <t t-if="task.confirm_state">
                                            <span t-att-class="'badge ' + (task.confirm_state == 'confirmed' and 'bg-success' or task.confirm_state == 'cancelled' and 'bg-danger' or 'bg-secondary')">
                                                <t t-esc="dict(task._fields['confirm_state'].selection).get(task.confirm_state)"/>
                                            </span>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-call="portal.pager"/>
                </t>
                <t t-else="">
                    <div class="text-center text-muted py-5">
                        <i class="fa fa-check-circle fa-3x mb-3"/>
                        <br/>
                        暂无待调度任务
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- 供应商总览                                                      -->
    <!-- ============================================================ -->
    <template id="portal_coo_suppliers" name="COO Supplier Overview">
        <t t-call="tour_coo_portal.portal_coo_layout">
            <div class="o_coo_suppliers">
                <h3 class="mb-3">
                    <i class="fa fa-building me-2"/>供应商总览
                </h3>

                <!-- 分布统计 -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">类型分布</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="supplier_type_distribution">
                                    <table class="table table-sm table-borderless mb-0">
                                        <thead>
                                            <tr>
                                                <th>类型</th>
                                                <th class="text-end">数量</th>
                                                <th class="text-end">占比</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="supplier_type_distribution" t-as="item">
                                                <tr>
                                                    <td><t t-esc="item['label']"/></td>
                                                    <td class="text-end"><t t-esc="item['count']"/></td>
                                                    <td class="text-end"><t t-esc="item['percentage']"/>%</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted text-center mb-0">暂无供应商数据</p>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">等级分布</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="supplier_level_distribution">
                                    <table class="table table-sm table-borderless mb-0">
                                        <thead>
                                            <tr>
                                                <th>等级</th>
                                                <th class="text-end">数量</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="supplier_level_distribution" t-as="item">
                                                <tr>
                                                    <td><t t-esc="item['label']"/></td>
                                                    <td class="text-end"><t t-esc="item['count']"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted text-center mb-0">暂无等级数据</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 即将到期合同预警 -->
                <t t-if="expiring_contracts">
                    <div class="alert alert-warning mb-4">
                        <h5 class="alert-heading">
                            <i class="fa fa-exclamation-triangle me-2"/>合同到期预警（30 天内）
                        </h5>
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr>
                                    <th>供应商</th>
                                    <th>类型</th>
                                    <th>合同编号</th>
                                    <th>到期日</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="expiring_contracts" t-as="sup">
                                    <tr>
                                        <td><t t-esc="sup.name"/></td>
                                        <td><t t-esc="dict(sup._fields['sup_type'].selection).get(sup.sup_type)"/></td>
                                        <td><t t-esc="sup.contract_no or '-'"/></td>
                                        <td><t t-esc="sup.contract_end_date" t-options="{'widget': 'date'}"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <!-- 搜索栏 -->
                <form class="mb-3" method="GET" action="/my/coo/suppliers">
                    <div class="input-group">
                        <input type="text" class="form-control" name="search"
                               placeholder="搜索供应商名称、合同号、负责人..."
                               t-att-value="search"/>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-search"/> 搜索
                        </button>
                    </div>
                </form>

                <!-- 供应商列表 -->
                <t t-if="suppliers">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>供应商名称</th>
                                <th>类型</th>
                                <th>等级</th>
                                <th>合同编号</th>
                                <th>合同到期日</th>
                                <th>已签约</th>
                                <th>已审核</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="suppliers" t-as="sup">
                                <tr>
                                    <td><t t-esc="sup.name"/></td>
                                    <td><t t-esc="dict(sup._fields['sup_type'].selection).get(sup.sup_type)"/></td>
                                    <td><t t-esc="dict(sup._fields['level_id'].selection).get(sup.level_id) if sup.level_id else '-'"/></td>
                                    <td><t t-esc="sup.contract_no or '-'"/></td>
                                    <td><t t-esc="sup.contract_end_date" t-options="{'widget': 'date'}" t-if="sup.contract_end_date"/><t t-else="">-</t></td>
                                    <td>
                                        <span t-att-class="'badge ' + (sup.is_contract and 'bg-success' or 'bg-secondary')">
                                            <t t-esc="sup.is_contract and '是' or '否'"/>
                                        </span>
                                    </td>
                                    <td>
                                        <span t-att-class="'badge ' + (sup.audit_chk and 'bg-success' or 'bg-secondary')">
                                            <t t-esc="sup.audit_chk and '是' or '否'"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-call="portal.pager"/>
                </t>
                <t t-else="">
                    <div class="text-center text-muted py-5">
                        <i class="fa fa-building fa-3x mb-3"/>
                        <br/>
                        暂无供应商数据
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- 运营审批                                                       -->
    <!-- ============================================================ -->
    <template id="portal_coo_approvals" name="COO Operations Approvals">
        <t t-call="tour_coo_portal.portal_coo_layout">
            <div class="o_coo_approvals">
                <h3 class="mb-3">
                    <i class="fa fa-check-square me-2"/>运营审批
                </h3>
                <t t-if="plans">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>团号</th>
                                <th>计划名称</th>
                                <th>客户</th>
                                <th>出发日期</th>
                                <th>返回日期</th>
                                <th class="text-end">人数</th>
                                <th>审核状态</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="plans" t-as="plan">
                                <tr>
                                    <td><t t-esc="plan.plan_code"/></td>
                                    <td><t t-esc="plan.line_id.name or '-'"/></td>
                                    <td><t t-esc="plan.supplier_id.name or '-'"/></td>
                                    <td><t t-esc="plan.begin_date" t-options="{'widget': 'date'}"/></td>
                                    <td><t t-esc="plan.end_date" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end"><t t-esc="plan.guest_count"/></td>
                                    <td>
                                        <span class="badge bg-warning">
                                            <t t-esc="dict(plan._fields['operation_audit_state'].selection).get(plan.operation_audit_state)"/>
                                        </span>
                                    </td>
                                    <td>
                                        <form method="POST" t-att-action="'/my/coo/approvals/%s/approve' % plan.id"
                                              class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="action" value="approve"/>
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    onclick="return confirm('确认通过此审批？')">
                                                <i class="fa fa-check me-1"/>通过
                                            </button>
                                        </form>
                                        <form method="POST" t-att-action="'/my/coo/approvals/%s/approve' % plan.id"
                                              class="d-inline ms-1">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="action" value="reject"/>
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('确认驳回此审批？')">
                                                <i class="fa fa-times me-1"/>驳回
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-call="portal.pager"/>
                </t>
                <t t-else="">
                    <div class="text-center text-muted py-5">
                        <i class="fa fa-check-circle fa-3x mb-3"/>
                        <br/>
                        暂无待审批团队
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
