<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- COO 门户：可以查看所有运营数据 -->

    <!-- tour.plan: COO 可以查看所有团队（含审批写入） -->
    <record id="rule_plan_coo" model="ir.rule">
        <field name="name">tour.plan: COO sees all plans</field>
        <field name="model_id" ref="tour_order.model_tour_plan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_coo_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

