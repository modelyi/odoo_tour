<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View (must be before action that references it) -->
    <record id="view_tour_line_search" model="ir.ui.view">
        <field name="name">tour.line.search</field>
        <field name="model">tour.line</field>
        <field name="arch" type="xml">
            <search string="线路搜索">
                <filter name="active" string="启用" domain="[('active','=',True)]"/>
                <filter name="inactive" string="停用" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="approved" string="已审核" domain="[('audit_state','=','approved')]"/>
                <filter name="draft" string="草稿" domain="[('audit_state','=','draft')]"/>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_tour_line" model="ir.actions.act_window">
        <field name="name">线路产品</field>
        <field name="res_model">tour.line</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_tour_line_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_tour_product_category" model="ir.actions.act_window">
        <field name="name">产品分类</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Kanban View（按产品分类分列） -->
    <record id="view_tour_line_kanban" model="ir.ui.view">
        <field name="name">tour.line.kanban</field>
        <field name="model">tour.line</field>
        <field name="arch" type="xml">
            <kanban default_group_by="categ_id" class="o_kanban_mobile"
                    group_create="false" group_delete="false" group_edit="false">
                <field name="name"/>
                <field name="default_code"/>
                <field name="categ_id"/>
                <field name="day_num"/>
                <field name="list_price"/>
                <field name="audit_state"/>
                <field name="departure_count"/>
                <field name="detail_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start gap-1">
                            <field name="name" class="fw-bold text-truncate flex-grow-1"/>
                            <field name="audit_state" widget="badge"
                                decoration-info="audit_state == 'draft'"
                                decoration-warning="audit_state == 'submitted'"
                                decoration-success="audit_state == 'approved'"
                                decoration-danger="audit_state == 'rejected'"/>
                        </div>
                        <div class="text-muted small">
                            <field name="default_code"/>
                        </div>
                        <div class="mt-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">产品分类</span>
                                <field name="categ_id"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">天数</span>
                                <field name="day_num"/>
                            </div>
                        </div>
                        <footer class="pt-1 mt-1 border-top d-flex flex-column">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">起价</span>
                                <field name="list_price" widget="monetary"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">发团</span>
                                <field name="departure_count"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">行程</span>
                                <field name="detail_count"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_tour_line_list" model="ir.ui.view">
        <field name="name">tour.line.list</field>
        <field name="model">tour.line</field>
        <field name="arch" type="xml">
            <list string="线路产品">
                <field name="sequence" widget="handle"/>
                <field name="default_code"/>
                <field name="name"/>
                <field name="categ_id"/>
                <field name="day_num"/>
                <field name="send_place"/>
                <field name="end_place"/>
                <field name="list_price" widget="monetary"/>
                <field name="audit_state" widget="badge"
                    decoration-info="audit_state == 'draft'"
                    decoration-warning="audit_state == 'submitted'"
                    decoration-success="audit_state == 'approved'"
                    decoration-danger="audit_state == 'rejected'"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tour_line_form" model="ir.ui.view">
        <field name="name">tour.line.form</field>
        <field name="model">tour.line</field>
        <field name="arch" type="xml">
            <form string="线路产品">
                <header>
                    <button name="action_submit" string="提交审核" type="object"
                        class="btn-primary" invisible="audit_state != 'draft'"/>
                    <button name="action_approve" string="审核通过" type="object"
                        class="btn-primary" invisible="audit_state != 'submitted'"/>
                    <button name="action_reject" string="拒绝" type="object"
                        invisible="audit_state != 'submitted'"/>
                    <button name="action_draft" string="重置草稿" type="object"
                        invisible="audit_state == 'draft'"/>
                    <field name="audit_state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_departures" type="object"
                            class="oe_stat_button" icon="fa-calendar"
                            help="查看该线路的发团计划">
                            <div class="o_stat_info">
                                <field name="departure_count" widget="statinfo" string="发团"/>
                            </div>
                        </button>
                        <button name="action_view_details" type="object"
                            class="oe_stat_button" icon="fa-list-ol"
                            help="查看该线路的行程明细">
                            <div class="o_stat_info">
                                <field name="detail_count" widget="statinfo" string="行程"/>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="线路名称"/>
                        </h1>
                    </div>
                    <group string="基础信息">
                        <group>
                            <field name="default_code"/>
                            <field name="help_code"/>
                            <field name="short_name"/>
                            <field name="categ_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="day_num"/>
                            <field name="night_num"/>
                            <field name="send_place"/>
                            <field name="end_place"/>
                            <field name="send_traffic"/>
                            <field name="end_traffic"/>
                        </group>
                        <group string="价格">
                            <field name="list_price"/>
                            <field name="child_price"/>
                            <field name="old_man_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="价格体系">
                            <group>
                                <group>
                                    <field name="list_price"/>
                                    <field name="child_price"/>
                                    <field name="old_man_price"/>
                                </group>
                                <group>
                                    <field name="student_price"/>
                                    <field name="baby_price"/>
                                </group>
                            </group>
                            <group>
                                <field name="fee_include"/>
                                <field name="fee_exclude"/>
                            </group>
                        </page>
                        <page string="行程/特色">
                            <field name="srv_text" placeholder="行程安排..."/>
                            <field name="details_rich" placeholder="行程详情..."/>
                            <field name="feature_rich" placeholder="线路特色..."/>
                        </page>
                        <page string="增值服务">
                            <field name="shopping_info" placeholder="购物信息..."/>
                            <field name="self_paid_item" placeholder="自费项目..."/>
                            <field name="warm_hint" placeholder="温馨提示..."/>
                            <field name="attentions" placeholder="注意事项..."/>
                        </page>
                        <page string="业务关联">
                            <group>
                                <group>
                                    <field name="dj_supplier_id"/>
                                    <field name="guide_share_rate"/>
                                    <field name="guide_premium"/>
                                </group>
                                <group>
                                    <field name="is_special"/>
                                    <field name="is_abroad"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
