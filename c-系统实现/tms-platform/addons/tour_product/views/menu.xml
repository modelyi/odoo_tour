<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Menu（根菜单 tour_base.menu_tms_root 已在 tour_base 定义） -->
    <menuitem id="menu_tms_product"
        name="线路产品"
        parent="tour_base.menu_tms_root"
        sequence="10"/>

    <menuitem id="menu_tour_line"
        name="线路模板"
        parent="menu_tms_product"
        action="action_tour_line"
        sequence="10"/>

    <menuitem id="menu_tour_line_type"
        name="线路分类"
        parent="menu_tms_product"
        action="action_tour_line_type"
        sequence="20"/>

    <menuitem id="menu_tour_departure"
        name="发团计划"
        parent="menu_tms_product"
        action="action_tour_departure"
        sequence="30"/>

    <!-- 线路产品配置（Odoo 惯例：配置菜单放最后） -->
    <menuitem id="menu_tms_product_config"
        name="配置"
        parent="menu_tms_product"
        sequence="90"/>

    <menuitem id="menu_tour_base_item"
        name="通用基础数据"
        parent="menu_tms_product_config"
        action="action_tour_base_item"
        sequence="10"/>

    <!--
        结算方式 / 业务类型：action 定义在 tour_product，parent 由下游模块挂载：
        - 结算方式 → tour_accounting「财务配置」
        - 业务类型 → tour_order「订单配置」
    -->
    <menuitem id="menu_tour_pay_way"
        name="结算方式"
        action="action_tour_pay_way"/>

    <menuitem id="menu_tour_biz_type"
        name="业务类型"
        action="action_tour_biz_type"/>
</odoo>
