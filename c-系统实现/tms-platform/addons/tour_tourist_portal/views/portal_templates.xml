<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 游客门户布局模板 -->
    <template id="portal_tourist_layout" name="Tourist Portal Layout">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container mt-3">
                    <div class="row">
                        <!-- 侧边栏 -->
                        <div class="col-md-3">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-suitcase me-2"/>游客门户
                                    </h5>
                                </div>
                                <div class="list-group list-group-flush">
                                    <a href="/my/tourist"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'tourist_home' else '')">
                                        <i class="fa fa-dashboard me-2"/>我的首页
                                    </a>
                                    <a href="/my/tourist/orders"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name in ['tourist_orders', 'tourist_order_detail'] else '')">
                                        <i class="fa fa-list-alt me-2"/>我的订单
                                    </a>
                                    <a href="/my/tourist/payments"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'tourist_payments' else '')">
                                        <i class="fa fa-money me-2"/>付款进度
                                    </a>
                                    <a href="/my/tourist/trips"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'tourist_trips' else '')">
                                        <i class="fa fa-plane me-2"/>我的行程
                                    </a>
                                    <a href="/my/tourist/invoices"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'tourist_invoices' else '')">
                                        <i class="fa fa-file-text-o me-2"/>发票管理
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- 主内容区 -->
                        <div class="col-md-9">
                            <t t-out="0"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- 无权限页面 -->
    <template id="portal_tourist_no_access" name="Tourist No Access">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container mt-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body text-center py-5">
                                    <i class="fa fa-lock fa-4x text-muted mb-3"/>
                                    <h3>无权访问</h3>
                                    <p class="text-muted">
                                        您没有游客门户的访问权限。<br/>
                                        请先注册或登录。
                                    </p>
                                    <div class="mt-3">
                                        <a href="/website/signup" class="btn btn-primary me-2">
                                            <i class="fa fa-user-plus me-1"/>注册
                                        </a>
                                        <a href="/web/login" class="btn btn-outline-secondary">
                                            <i class="fa fa-sign-in me-1"/>登录
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- 注册表单 -->
    <template id="portal_signup_form" name="Tourist Signup Form">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container mt-5">
                    <div class="row justify-content-center">
                        <div class="col-md-5">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h4 class="mb-0">
                                        <i class="fa fa-user-plus me-2"/>游客注册
                                    </h4>
                                </div>
                                <div class="card-body">
                                    <t t-if="error">
                                        <div class="alert alert-danger">
                                            <t t-esc="error"/>
                                        </div>
                                    </t>
                                    <form method="POST" action="/website/signup">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label for="phone" class="form-label">
                                                手机号 <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" class="form-control"
                                                   id="phone" name="phone"
                                                   placeholder="请输入 11 位手机号"
                                                   t-att-value="post.get('phone', '')"
                                                   required="required" maxlength="11"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="name" class="form-label">
                                                姓名 <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" class="form-control"
                                                   id="name" name="name"
                                                   placeholder="请输入您的姓名"
                                                   t-att-value="post.get('name', '')"
                                                   required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="password" class="form-label">
                                                密码 <span class="text-danger">*</span>
                                            </label>
                                            <input type="password" class="form-control"
                                                   id="password" name="password"
                                                   placeholder="至少 6 位"
                                                   required="required" minlength="6"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="confirm_password" class="form-label">
                                                确认密码 <span class="text-danger">*</span>
                                            </label>
                                            <input type="password" class="form-control"
                                                   id="confirm_password" name="confirm_password"
                                                   placeholder="再次输入密码"
                                                   required="required" minlength="6"/>
                                        </div>
                                        <button type="submit"
                                                class="btn btn-primary w-100">
                                            <i class="fa fa-check me-1"/>注册
                                        </button>
                                    </form>
                                    <div class="text-center mt-3">
                                        <span class="text-muted">已有账号？</span>
                                        <a href="/web/login">立即登录</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
