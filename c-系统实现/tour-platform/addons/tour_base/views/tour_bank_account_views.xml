<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 银行账户 List View -->
    <record id="view_tour_bank_account_list" model="ir.ui.view">
        <field name="name">tour.bank.account.list</field>
        <field name="model">tour.bank.account</field>
        <field name="arch" type="xml">
            <list string="银行账户">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="bank_id"/>
                <field name="acc_number"/>
                <field name="balance" sum="余额合计"/>
                <field name="taxpayer_no"/>
                <field name="trans_fee_rate"/>
                <field name="power_area"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- 银行账户 Form View -->
    <record id="view_tour_bank_account_form" model="ir.ui.view">
        <field name="name">tour.bank.account.form</field>
        <field name="model">tour.bank.account</field>
        <field name="arch" type="xml">
            <form string="银行账户">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="已停用" bg_color="bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bank_id"/>
                            <field name="acc_number"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="balance"/>
                            <field name="taxpayer_no"/>
                            <field name="trans_fee_rate"/>
                            <field name="power_area"/>
                        </group>
                    </group>
                    <group string="其他信息">
                        <field name="remark"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 银行账户 Search View -->
    <record id="view_tour_bank_account_search" model="ir.ui.view">
        <field name="name">tour.bank.account.search</field>
        <field name="model">tour.bank.account</field>
        <field name="arch" type="xml">
            <search string="搜索银行账户">
                <field name="name"/>
                <field name="acc_number"/>
                <field name="bank_id"/>
                <separator/>
                <filter name="active" string="已启用" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="已停用" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- 银行账户 Action -->
    <record id="action_tour_bank_account" model="ir.actions.act_window">
        <field name="name">银行账户</field>
        <field name="res_model">tour.bank.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tour_bank_account_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                创建旅行社自有银行账户
            </p>
        </field>
    </record>
</odoo>
