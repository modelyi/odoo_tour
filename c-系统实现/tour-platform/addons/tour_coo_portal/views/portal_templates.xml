<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- COO 门户布局模板 -->
    <template id="portal_coo_layout" name="COO Portal Layout">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container mt-3">
                    <div class="row">
                        <!-- 侧边栏 -->
                        <div class="col-md-3">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-cogs me-2"/>COO 门户
                                    </h5>
                                </div>
                                <div class="list-group list-group-flush">
                                    <a href="/my/coo"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'coo_home' else '')">
                                        <i class="fa fa-dashboard me-2"/>运营概览
                                        <span t-if="active_plan_count" class="badge bg-primary ms-2">
                                            <t t-esc="active_plan_count"/>
                                        </span>
                                    </a>
                                    <a href="/my/coo/orders"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'coo_orders' else '')">
                                        <i class="fa fa-line-chart me-2"/>订单管线
                                    </a>
                                    <a href="/my/coo/dispatches"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'coo_dispatches' else '')">
                                        <i class="fa fa-calendar me-2"/>资源调度
                                        <span t-if="pending_dispatch_count" class="badge bg-warning ms-2">
                                            <t t-esc="pending_dispatch_count"/>
                                        </span>
                                    </a>
                                    <a href="/my/coo/suppliers"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'coo_suppliers' else '')">
                                        <i class="fa fa-building me-2"/>供应商
                                    </a>
                                    <a href="/my/coo/approvals"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'coo_approvals' else '')">
                                        <i class="fa fa-check-square me-2"/>运营审批
                                        <span t-if="pending_approval_count" class="badge bg-danger ms-2">
                                            <t t-esc="pending_approval_count"/>
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- 主内容区 -->
                        <div class="col-md-9">
                            <t t-out="0"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- 无权限页面 -->
    <template id="portal_coo_no_access" name="COO No Access">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container mt-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body text-center py-5">
                                    <i class="fa fa-lock fa-4x text-muted mb-3"/>
                                    <h3>无权访问</h3>
                                    <p class="text-muted">
                                        您没有 COO 门户的访问权限。<br/>
                                        请联系系统管理员获取 COO 角色。
                                    </p>
                                    <a href="/my" class="btn btn-primary mt-3">
                                        <i class="fa fa-home me-2"/>返回我的门户
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
