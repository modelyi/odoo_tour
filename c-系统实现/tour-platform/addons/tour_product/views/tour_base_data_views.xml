<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ 收付场景 tour.pay.way ============ -->
    <record id="action_tour_pay_way" model="ir.actions.act_window">
        <field name="name">收付场景</field>
        <field name="res_model">tour.pay.way</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tour_pay_way_list" model="ir.ui.view">
        <field name="name">tour.pay.way.list</field>
        <field name="model">tour.pay.way</field>
        <field name="arch" type="xml">
            <list string="收付场景">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_credit"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_tour_pay_way_form" model="ir.ui.view">
        <field name="name">tour.pay.way.form</field>
        <field name="model">tour.pay.way</field>
        <field name="arch" type="xml">
            <form string="收付场景">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="is_credit"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="brief"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
