<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 顶级菜单「产品导览」：仅超级用户（base.group_system）可见 -->
    <menuitem id="menu_tutor_root"
        name="产品导览"
        sequence="100"
        groups="base.group_system"/>

    <menuitem id="menu_tutor_index"
        name="产品导览文档"
        parent="menu_tutor_root"
        action="action_tutor_index"
        sequence="10"/>

    <menuitem id="menu_tutor_menus"
        name="角色菜单预览"
        parent="menu_tutor_root"
        action="action_tutor_menus"
        sequence="20"/>

    <!-- 打开产品导览文档（/tutor） -->
    <record id="action_tutor_index" model="ir.actions.act_url">
        <field name="name">产品导览文档</field>
        <field name="url">/tutor</field>
        <field name="target">self</field>
    </record>

    <!-- 打开角色菜单预览（/tutor/menus） -->
    <record id="action_tutor_menus" model="ir.actions.act_url">
        <field name="name">角色菜单预览</field>
        <field name="url">/tutor/menus</field>
        <field name="target">self</field>
    </record>
</odoo>
