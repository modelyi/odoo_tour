<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CFO 门户布局模板 -->
    <template id="portal_cfo_layout" name="CFO Portal Layout">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container mt-3">
                    <div class="row">
                        <!-- 侧边栏 -->
                        <div class="col-md-3">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-briefcase me-2"/>CFO 门户
                                    </h5>
                                </div>
                                <div class="list-group list-group-flush">
                                    <a href="/my/cfo"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'cfo_home' else '')">
                                        <i class="fa fa-dashboard me-2"/>财务概览
                                    </a>
                                    <a href="/my/cfo/expenses"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name in ['cfo_expenses', 'cfo_expense_detail'] else '')">
                                        <i class="fa fa-file-text-o me-2"/>报账审批
                                        <span t-if="expense_approval_count" class="badge bg-danger ms-2">
                                            <t t-esc="expense_approval_count"/>
                                        </span>
                                    </a>
                                    <a href="/my/cfo/commissions"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'cfo_commissions' else '')">
                                        <i class="fa fa-money me-2"/>佣金审批
                                        <span t-if="commission_approval_count" class="badge bg-warning ms-2">
                                            <t t-esc="commission_approval_count"/>
                                        </span>
                                    </a>
                                    <a href="/my/cfo/loans"
                                       t-att-class="'list-group-item list-group-item-action' + (' active' if page_name == 'cfo_loans' else '')">
                                        <i class="fa fa-credit-card me-2"/>借款审批
                                        <span t-if="loan_approval_count" class="badge bg-info ms-2">
                                            <t t-esc="loan_approval_count"/>
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- 主内容区 -->
                        <div class="col-md-9">
                            <t t-out="0"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- 无权限页面 -->
    <template id="portal_cfo_no_access" name="CFO No Access">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container mt-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body text-center py-5">
                                    <i class="fa fa-lock fa-4x text-muted mb-3"/>
                                    <h3>无权访问</h3>
                                    <p class="text-muted">
                                        您没有 CFO 门户的访问权限。<br/>
                                        请联系系统管理员获取 CFO 角色。
                                    </p>
                                    <a href="/my" class="btn btn-primary mt-3">
                                        <i class="fa fa-home me-2"/>返回我的门户
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
