<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 请款单（采购付款审批）列表视图 [TDS §2.3] -->
    <record id="view_tour_pay_request_list" model="ir.ui.view">
        <field name="name">tour.pay.request.list</field>
        <field name="model">tour.pay.request</field>
        <field name="arch" type="xml">
            <list string="请款单" create="1" delete="1">
                <field name="name"/>
                <field name="plan_code"/>
                <field name="supplier_id"/>
                <field name="amount" widget="monetary" sum="总请款金额" decoration-danger="state != 'paid'"/>
                <field name="cost_type"/>
                <field name="audit_level"/>
                <field name="state" widget="badge" decoration-success="state=='paid'" decoration-info="state=='approved'" decoration-warning="state=='draft'" decoration-danger="state=='rejected'"/>
                <field name="bill_id" optional="hide"/>
                <field name="payment_id" optional="hide"/>
                <field name="apply_date"/>
                <field name="applicant_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- 请款单表单视图 -->
    <record id="view_tour_pay_request_form" model="ir.ui.view">
        <field name="name">tour.pay.request.form</field>
        <field name="model">tour.pay.request</field>
        <field name="arch" type="xml">
            <form string="请款单">
                <header>
                    <button name="action_approve" string="审批通过" type="object"
                            class="btn-primary"/>
                    <button name="action_reject" string="驳回" type="object"/>
                    <button name="action_pay" string="标记已付款" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bill" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="bill_count"/></span>
                                <span class="o_stat_text">账单</span>
                            </div>
                        </button>
                        <button name="action_view_payment" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="payment_count"/></span>
                                <span class="o_stat_text">付款单</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="plan_id"/>
                            <field name="supplier_id"/>
                            <field name="amount" widget="monetary"/>
                            <field name="cost_type"/>
                            <field name="cost_account_id"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="audit_level"/>
                            <field name="applicant_id"/>
                            <field name="approver_id"/>
                            <field name="approve_date"/>
                            <field name="apply_date"/>
                            <field name="bill_id"/>
                            <field name="payment_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tour_pay_request_kanban" model="ir.ui.view">
        <field name="name">tour.pay.request.kanban</field>
        <field name="model">tour.pay.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state" create="false">
                <field name="name"/>
                <field name="state"/>
                <field name="plan_code"/>
                <field name="supplier_id"/>
                <field name="amount"/>
                <field name="audit_level"/>
                <field name="apply_date"/>
                <field name="bill_count"/>
                <field name="payment_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong><field name="name"/></strong>
                                <field name="state" widget="badge"
                                    decoration-success="state == 'paid'"
                                    decoration-info="state == 'approved'"
                                    decoration-warning="state == 'draft'"
                                    decoration-danger="state == 'rejected'"/>
                            </div>
                            <div class="text-muted o_kanban_record_subtitle"><field name="supplier_id"/></div>
                            <div class="d-flex justify-content-between mt8">
                                <span class="text-muted">团号</span>
                                <field name="plan_code"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold">请款金额</span>
                                <span class="fw-bold"><field name="amount" decoration-danger="state != 'paid'"/></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>审批级别</span>
                                <field name="audit_level"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>申请日期</span>
                                <field name="apply_date"/>
                            </div>
                            <footer>
                                <button name="action_view_bill" type="object"
                                    class="btn btn-link btn-sm oe_stat_button" icon="fa-file-text-o">
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="bill_count"/></span>
                                        <span class="o_stat_text">账单</span>
                                    </div>
                                </button>
                                <button name="action_view_payment" type="object"
                                    class="btn btn-link btn-sm oe_stat_button" icon="fa-money">
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="payment_count"/></span>
                                        <span class="o_stat_text">付款单</span>
                                    </div>
                                </button>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_tour_pay_request" model="ir.actions.act_window">
        <field name="name">请款单</field>
        <field name="res_model">tour.pay.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">采购付款请款单（P2P）</p>
            <p>由 tour.plan 成本（out_sum）生成供应商应付账单后，走分级审批 → 付款 → 核销。</p>
        </field>
    </record>

    <menuitem id="menu_tour_pay_request"
        name="请款单"
        parent="menu_tms_daily_ops"
        action="action_tour_pay_request"
        groups="tour_base.group_tour_finance"
        sequence="12"/>
</odoo>
