<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_payment_claim_search" model="ir.ui.view">
        <field name="name">tour.payment.claim.search</field>
        <field name="model">tour.payment.claim</field>
        <field name="arch" type="xml">
            <search string="收款登记搜索">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="plan_id"/>
                <field name="plan_code"/>
                <field name="account_id"/>
                <field name="pay_way_id"/>
                <field name="pay_channel_id"/>
                <field name="pay_date"/>
                <separator/>
                <filter name="group_state" string="认领状态" context="{'group_by':'claim_state'}"/>
                <filter name="group_channel" string="支付渠道" context="{'group_by':'pay_channel_id'}"/>
                <filter name="state_0" string="待认领" domain="[('claim_state','=','0')]"/>
                <filter name="state_1" string="待审核" domain="[('claim_state','=','1')]"/>
                <filter name="state_2" string="已审核" domain="[('claim_state','=','2')]"/>
                <filter name="state_3" string="已平账" domain="[('claim_state','=','3')]"/>
            </search>
        </field>
    </record>

    <record id="action_tour_payment_claim" model="ir.actions.act_window">
        <field name="name">收款登记/认领</field>
        <field name="res_model">tour.payment.claim</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_tour_payment_claim_search"/>
    </record>

    <record id="view_tour_payment_claim_list" model="ir.ui.view">
        <field name="name">tour.payment.claim.list</field>
        <field name="model">tour.payment.claim</field>
        <field name="arch" type="xml">
            <list string="收款登记/认领">
                <field name="name"/>
                <field name="pay_date"/>
                <field name="supplier_id"/>
                <field name="plan_code"/>
                <field name="pay_money" sum="收款合计"/>
                <field name="use_money"/>
                <field name="balance_money" decoration-danger="balance_money &lt; 0"/>
                <field name="pay_channel_id"/>
                <field name="account_id"/>
                <field name="claim_state" widget="badge" decoration-success="claim_state=='3'" decoration-info="claim_state=='2'" decoration-warning="claim_state=='1'"/>
                <field name="move_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tour_payment_claim_kanban" model="ir.ui.view">
        <field name="name">tour.payment.claim.kanban</field>
        <field name="model">tour.payment.claim</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="claim_state" create="false">
                <field name="name"/>
                <field name="claim_state"/>
                <field name="supplier_id"/>
                <field name="plan_code"/>
                <field name="pay_money"/>
                <field name="balance_money"/>
                <field name="pay_channel_id"/>
                <field name="move_count"/>
                <field name="reconcile_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong><field name="name"/></strong>
                                <field name="claim_state" widget="badge"
                                    decoration-success="claim_state == '3'"
                                    decoration-info="claim_state == '2'"
                                    decoration-warning="claim_state == '1'"
                                    decoration-muted="claim_state == '0'"/>
                            </div>
                            <div class="text-muted o_kanban_record_subtitle"><field name="supplier_id"/></div>
                            <div class="d-flex justify-content-between mt8">
                                <span class="text-muted">团号</span>
                                <field name="plan_code"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold">收款金额</span>
                                <span class="fw-bold"><field name="pay_money"/></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>余额</span>
                                <field name="balance_money" decoration-danger="balance_money &lt; 0"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>支付渠道</span>
                                <field name="pay_channel_id"/>
                            </div>
                            <footer>
                                <button name="action_view_move" type="object"
                                    class="btn btn-link btn-sm oe_stat_button" icon="fa-file-text-o">
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="move_count"/></span>
                                        <span class="o_stat_text">凭证</span>
                                    </div>
                                </button>
                                <button name="action_view_reconcile" type="object"
                                    class="btn btn-link btn-sm oe_stat_button" icon="fa-exchange">
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="reconcile_count"/></span>
                                        <span class="o_stat_text">核销</span>
                                    </div>
                                </button>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_tour_payment_claim_form" model="ir.ui.view">
        <field name="name">tour.payment.claim.form</field>
        <field name="model">tour.payment.claim</field>
        <field name="arch" type="xml">
            <form string="收款登记/认领">
                <header>
                    <button name="action_claim" string="认领" type="object" class="btn-primary"
                        invisible="claim_state != '0'"/>
                    <button name="action_audit" string="审核" type="object" class="btn-primary"
                        invisible="claim_state != '1'"/>
                    <button name="action_settle" string="平账" type="object"
                        invisible="claim_state != '2'"/>
                    <button name="action_reject" string="退回" type="object"
                        invisible="claim_state != '1'"/>
                    <field name="claim_state" widget="statusbar" statusbar_visible="0,1,2,3"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="move_count"/></span>
                                <span class="o_stat_text">凭证</span>
                            </div>
                        </button>
                        <button name="action_view_reconcile" type="object" class="oe_stat_button" icon="fa-exchange">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="reconcile_count"/></span>
                                <span class="o_stat_text">核销</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="收款编号"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="payee_id"/>
                            <field name="pay_date"/>
                            <field name="pay_money"/>
                            <field name="use_money"/>
                            <field name="balance_money"/>
                        </group>
                        <group>
                            <field name="supplier_id"/>
                            <field name="account_id"/>
                            <field name="plan_id"/>
                            <field name="plan_code"/>
                            <field name="star_state"/>
                        </group>
                    </group>
                    <group string="结算方式（两维度）">
                        <field name="pay_way_id"/>
                        <field name="pay_channel_id"/>
                    </group>
                    <group string="付款方信息">
                        <field name="bank_name_pay"/>
                        <field name="account_name_pay"/>
                        <field name="account_no_pay"/>
                        <field name="tax_code"/>
                    </group>
                    <group string="手续费">
                        <field name="trans_fee_rate"/>
                        <field name="trans_fee"/>
                    </group>
                    <group string="摘要">
                        <field name="brief"/>
                    </group>
                    <group string="会计凭证">
                        <field name="move_id"/>
                        <field name="move_state"/>
                    </group>
                    <group string="收款认领明细（核销发票）">
                        <field name="claim_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="invoice_id" domain="[('move_type','=','out_invoice')]"/>
                                <field name="amount"/>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                    <group string="留痕">
                        <field name="company_id"/>
                        <field name="department_id"/>
                        <field name="op_user_id"/>
                        <field name="op_date"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
