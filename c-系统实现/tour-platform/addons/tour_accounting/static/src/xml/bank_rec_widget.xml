<templates>
    <t t-name="tour_accounting.CustomKanbanView" t-inherit="web.KanbanView">
        <xpath expr="//Layout" position="inside">
            <div class="h-100 form_view_class">
                <View t-if="state.selectedStLineId"
                      t-props="prepareFormPropsBankReconcile"
                      t-key="state.selectedStLineId"/>
            </div>
        </xpath>
    </t>
    <t t-name="tour_accounting.BankRecKanbanRenderer"
        t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
            <xpath expr="//div[hasclass('o_kanban_renderer')]"
               position="attributes">
                <attribute name="class">o_kanban_renderer o_custom_class</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_custom_class')]"
                   position="attributes">
                <attribute name="style">width:30%;</attribute>
            </xpath>
    </t>
    <t t-name="tour_accounting.BankReconcileKanbanRecord"
       t-inherit="web.KanbanRecord" t-inherit-mode="primary">
    </t>
    <t t-name="tour_accounting.AccountMoveLineListController"
       t-inherit="web.ListView"
       t-inherit-mode="primary">
    </t>
</templates>
