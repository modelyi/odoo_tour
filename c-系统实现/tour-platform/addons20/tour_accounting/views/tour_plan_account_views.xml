<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_plan_account_search" model="ir.ui.view">
        <field name="name">tour.plan.account.search</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <search string="单团核算搜索">
                <field name="plan_code"/>
                <field name="plan_id"/>
                <field name="line_id"/>
                <field name="sales_name"/>
                <field name="supplier_id"/>
                <field name="biz_mode"/>
                <field name="company_id"/>
                <field name="department_id"/>
                <separator/>
                <filter name="group_biz" string="业务模式" context="{'group_by':'biz_mode'}"/>
                <filter name="group_state" string="状态" context="{'group_by':'state'}"/>
                <filter name="group_line" string="线路" context="{'group_by':'line_id'}"/>
                <filter name="group_sales" string="销售归属" context="{'group_by':'sales_name'}"/>
                <filter name="group_supplier" string="客户" context="{'group_by':'supplier_id'}"/>
                <filter name="receivable_positive" string="真应收(客户欠款)"
                        domain="[('receivable_positive','>',0)]"/>
                <filter name="receivable_negative" string="溢缴(转预收)"
                        domain="[('receivable_negative','>',0)]"/>
                <filter name="state_accounting" string="核算中" domain="[('state','=','accounting')]"/>
                <filter name="state_settled" string="已结算" domain="[('state','=','settled')]"/>
                <filter name="state_archived" string="已归档" domain="[('state','=','archived')]"/>
            </search>
        </field>
    </record>

    <record id="action_tour_plan_account" model="ir.actions.act_window">
        <field name="name">单团核算</field>
        <field name="res_model">tour.plan.account</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_tour_plan_account_search"/>
    </record>

    <record id="view_tour_plan_account_kanban" model="ir.ui.view">
        <field name="name">tour.plan.account.kanban</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="plan_code"/>
                <field name="plan_id"/>
                <field name="income_total"/>
                <field name="cost_total"/>
                <field name="profit"/>
                <field name="state"/>
                <field name="supplier_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline mb-2">
                            <field name="plan_code" class="fw-bolder fs-5 me-2"/>
                            <field name="profit" widget="monetary" class="fw-bolder ms-auto flex-shrink-0"/>
                        </div>
                        <div class="text-muted mb-2">
                            <field name="supplier_id"/>
                        </div>
                        <div class="d-flex justify-content-between mt4">
                            <span class="text-muted">收入</span>
                            <field name="income_total" widget="monetary"/>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">成本</span>
                            <field name="cost_total" widget="monetary"/>
                        </div>
                        <footer class="align-items-end">
                            <field name="state" widget="badge"
                                decoration-success="state=='settled'"
                                decoration-info="state=='accounting'"
                                decoration-muted="state=='archived'"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_tour_plan_account_list" model="ir.ui.view">
        <field name="name">tour.plan.account.list</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <list string="单团核算">
                <field name="plan_code"/>
                <field name="plan_id"/>
                <field name="biz_mode"/>
                <field name="income_total" sum="收入合计"/>
                <field name="income_commission"/>
                <field name="cost_total" sum="成本合计"/>
                <field name="cost_net_total" sum="不含税成本"/>
                <field name="receivable"/>
                <field name="profit" sum="毛利(不含税)"/>
                <field name="profit_no_shop"/>
                <field name="profit_tax_incl" sum="毛利(含税口径)"/>
                <field name="state" widget="badge" decoration-success="state=='settled'" decoration-info="state=='accounting'" decoration-muted="state=='archived'"/>
            </list>
        </field>
    </record>

    <record id="view_tour_plan_account_form" model="ir.ui.view">
        <field name="name">tour.plan.account.form</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <form string="单团核算">
                <header>
                    <button name="action_settle" string="结算" type="object" class="btn-primary"
                        invisible="state != 'accounting'"/>
                    <button name="action_archive" string="归档" type="object"
                        invisible="state != 'settled'"/>
                    <button name="action_reopen" string="重开核算" type="object"
                        invisible="state == 'accounting'"/>
                    <field name="state" widget="statusbar" statusbar_visible="accounting,settled,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="发票"/>
                        </button>
                        <button name="action_view_claims" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="claim_count" widget="statinfo" string="收款"/>
                        </button>
                        <button name="action_view_analytic_lines" type="object"
                                class="oe_stat_button" icon="fa-list-alt">
                            <field name="analytic_move_count" widget="statinfo" string="凭证行"/>
                        </button>
                        <button name="action_view_dunnings" type="object"
                                class="oe_stat_button" icon="fa-bell">
                            <field name="dunning_count" widget="statinfo" string="催收"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="plan_code" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="plan_id"/>
                        </h2>
                    </div>
                    <group>
                        <group string="基本信息">
                            <field name="biz_mode"/>
                            <field name="analytic_account_id"/>
                            <field name="currency_id" column_invisible="True"/>
                        </group>
                        <group string="归属">
                            <field name="company_id"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="收入" name="income">
                            <group>
                                <group>
                                    <field name="income_total" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                                <group>
                                    <field name="income_commission" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="成本" name="cost">
                            <group>
                                <group>
                                    <field name="cost_total" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="cost_deductible" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                                <group>
                                    <field name="cost_non_deductible" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="增值税" name="vat">
                            <group>
                                <group>
                                    <field name="vat_deductible_total" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="vat_deduct_amount" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                                <group>
                                    <field name="vat_output_amount" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="vat_payable" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="应收/预收/发票" name="receivable">
                            <group>
                                <group>
                                    <field name="receivable" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="receivable_positive" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="receivable_negative" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                                <group>
                                    <field name="prepaid" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="invoice_gap" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="应收账龄" name="aging">
                            <group>
                                <group>
                                    <field name="overdue_days"/>
                                    <field name="aging_0_30" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="aging_31_90" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                                <group>
                                    <field name="aging_91_180" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="aging_181_365" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="aging_over_365" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="利润" name="profit">
                            <group>
                                <group>
                                    <field name="cost_net_total" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="profit" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                                <group>
                                    <field name="profit_no_shop" widget="monetary"
                                           currency_field="currency_id"/>
                                    <field name="profit_tax_incl" widget="monetary"
                                           currency_field="currency_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 团款应收四维账龄分析（BS-12 §5.2）：按团/线路/销售员/客户 pivot 分析 -->
    <record id="view_tour_plan_account_aging_pivot" model="ir.ui.view">
        <field name="name">tour.plan.account.aging.pivot</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <pivot string="团款应收四维账龄" disable_linking="True">
                <field name="line_id" type="row"/>
                <field name="sales_name" type="col"/>
                <field name="supplier_id" type="row"/>
                <field name="receivable_positive" type="measure"/>
                <field name="aging_0_30" type="measure"/>
                <field name="aging_31_90" type="measure"/>
                <field name="aging_91_180" type="measure"/>
                <field name="aging_181_365" type="measure"/>
                <field name="aging_over_365" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tour_plan_account_aging_graph" model="ir.ui.view">
        <field name="name">tour.plan.account.aging.graph</field>
        <field name="model">tour.plan.account</field>
        <field name="arch" type="xml">
            <graph string="团款应收账龄分布">
                <field name="line_id"/>
                <field name="receivable_positive" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_tour_plan_account_aging" model="ir.actions.act_window">
        <field name="name">团款应收账龄分析（四维）</field>
        <field name="res_model">tour.plan.account</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_tour_plan_account_search"/>
        <field name="domain">[('receivable_positive', '&gt;', 0)]</field>
        <field name="context">{'search_default_receivable_positive': 1}</field>
    </record>
</odoo>
