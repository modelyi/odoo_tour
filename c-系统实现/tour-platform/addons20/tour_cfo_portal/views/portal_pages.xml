<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CFO 门户首页 -->
    <template id="portal_cfo_home" name="CFO Portal Home">
        <t t-call="tour_cfo_portal.portal_cfo_layout">
            <div class="o_cfo_home">
                <h3 class="mb-4">
                    <i class="fa fa-dashboard me-2"/>财务概览
                </h3>

                <!-- 统计卡片 -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card text-white bg-danger">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="card-title">待审批报账</h6>
                                        <h2 class="mb-0 mt-2"><t t-out="expense_approval_count"/></h2>
                                        <small>金额: ¥ <t t-out="'%.2f' % total_pending_expenses"/></small>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-file-text-o fa-3x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/cfo/expenses" class="text-white text-decoration-none">
                                    查看详情 <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-white bg-warning">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="card-title">待审批佣金</h6>
                                        <h2 class="mb-0 mt-2"><t t-out="commission_approval_count"/></h2>
                                        <small>金额: ¥ <t t-out="'%.2f' % total_pending_commissions"/></small>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-money fa-3x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/cfo/commissions" class="text-white text-decoration-none">
                                    查看详情 <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-white bg-info">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="card-title">待审批借款</h6>
                                        <h2 class="mb-0 mt-2"><t t-out="loan_approval_count"/></h2>
                                        <small>金额: ¥ <t t-out="'%.2f' % total_pending_loans"/></small>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-credit-card fa-3x opacity-50"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/cfo/loans" class="text-white text-decoration-none">
                                    查看详情 <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 最近待审批 -->
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">最近待审批项目</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <!-- 最近报账 -->
                                    <div class="col-md-4">
                                        <h6 class="text-danger">
                                            <i class="fa fa-file-text-o me-2"/>报账
                                        </h6>
                                        <t t-if="recent_expenses">
                                            <div class="list-group list-group-flush">
                                                <t t-foreach="recent_expenses[:5]" t-as="exp">
                                                    <a t-att-href="'/my/cfo/expenses/%s' % exp.id"
                                                       class="list-group-item list-group-item-action px-0">
                                                        <div class="d-flex justify-content-between">
                                                            <div>
                                                                <div><t t-out="exp.name or '-'"/></div>
                                                                <small class="text-muted">
                                                                    <t t-out="exp.date" t-options="{'widget': 'date'}"/>
                                                                </small>
                                                            </div>
                                                            <div class="text-end">
                                                                <div class="fw-bold">¥ <t t-out="'%.2f' % exp.total_amount"/></div>
                                                                <span class="badge bg-warning">
                                                                    <t t-out="dict(exp._fields['state'].selection).get(exp.state)"/>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </a>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted small">暂无待审批报账</p>
                                        </t>
                                    </div>

                                    <!-- 最近佣金 -->
                                    <div class="col-md-4">
                                        <h6 class="text-warning">
                                            <i class="fa fa-money me-2"/>佣金
                                        </h6>
                                        <t t-if="recent_commissions">
                                            <div class="list-group list-group-flush">
                                                <t t-foreach="recent_commissions[:5]" t-as="com">
                                                    <div class="list-group-item px-0">
                                                        <div class="d-flex justify-content-between">
                                                            <div>
                                                                <div><t t-out="com.guide_id.name"/></div>
                                                                <small class="text-muted">
                                                                    <t t-out="com.plan_id.plan_code" t-if="com.plan_id"/>
                                                                </small>
                                                            </div>
                                                            <div class="text-end">
                                                                <div class="fw-bold">¥ <t t-out="'%.2f' % com.amount"/></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted small">暂无待审批佣金</p>
                                        </t>
                                    </div>

                                    <!-- 最近借款 -->
                                    <div class="col-md-4">
                                        <h6 class="text-info">
                                            <i class="fa fa-credit-card me-2"/>借款
                                        </h6>
                                        <t t-if="recent_loans">
                                            <div class="list-group list-group-flush">
                                                <t t-foreach="recent_loans[:5]" t-as="loan">
                                                    <div class="list-group-item px-0">
                                                        <div class="d-flex justify-content-between">
                                                            <div>
                                                                <div><t t-out="loan.guide_id.name"/></div>
                                                                <small class="text-muted">
                                                                    <t t-out="loan.apply_date" t-options="{'widget': 'date'}"/>
                                                                </small>
                                                            </div>
                                                            <div class="text-end">
                                                                <div class="fw-bold">¥ <t t-out="'%.2f' % loan.amount"/></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted small">暂无待审批借款</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- 报账审批列表 -->
    <template id="portal_cfo_expenses" name="CFO Expense Approvals">
        <t t-call="tour_cfo_portal.portal_cfo_layout">
            <div class="o_cfo_expenses">
                <h3 class="mb-3">
                    <i class="fa fa-file-text-o me-2"/>报账审批
                </h3>
                <t t-call="portal.portal_searchbar"/>
                <t t-if="expenses">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>报账说明</th>
                                <th>导游</th>
                                <th>团号</th>
                                <th>报账日期</th>
                                <th class="text-end">金额</th>
                                <th>状态</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="expenses" t-as="exp">
                                <tr>
                                    <td>
                                        <a t-att-href="'/my/cfo/expenses/%s' % exp.id">
                                            <t t-out="exp.name or '-'"/>
                                        </a>
                                    </td>
                                    <td><t t-out="exp.x_guide_id.name or exp.employee_id.name or '-'"/></td>
                                    <td><t t-out="exp.x_plan_code or '-'"/></td>
                                    <td><t t-out="exp.date" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end">¥ <t t-out="'%.2f' % exp.total_amount"/></td>
                                    <td>
                                        <span t-att-class="'badge ' + (exp.state == 'paid' and 'bg-success' or exp.state == 'approved' and 'bg-info' or 'bg-warning')">
                                            <t t-out="dict(exp._fields['state'].selection).get(exp.state)"/>
                                        </span>
                                    </td>
                                    <td>
                                        <a t-att-href="'/my/cfo/expenses/%s' % exp.id" class="btn btn-sm btn-primary">
                                            <i class="fa fa-eye"/> 审批
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-call="portal.pager"/>
                </t>
                <t t-else="">
                    <div class="text-center text-muted py-5">
                        <i class="fa fa-check-circle fa-3x mb-3"/>
                        <br/>
                        暂无待审批报账
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- 报账审批详情 -->
    <template id="portal_cfo_expense_detail" name="CFO Expense Approval Detail">
        <t t-call="tour_cfo_portal.portal_cfo_layout">
            <div class="o_cfo_expense_detail">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">报账审批详情</h3>
                    <a href="/my/cfo/expenses" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-arrow-left me-1"/>返回列表
                    </a>
                </div>

                <t t-if="error">
                    <div class="alert alert-danger">
                        <t t-out="error"/>
                    </div>
                </t>

                <div class="card">
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tr>
                                <th style="width: 150px;">报账说明</th>
                                <td><t t-out="expense.name or '-'"/></td>
                            </tr>
                            <tr>
                                <th>导游</th>
                                <td><t t-out="expense.x_guide_id.name or expense.employee_id.name or '-'"/></td>
                            </tr>
                            <tr>
                                <th>团号</th>
                                <td><t t-out="expense.x_plan_code or '-'"/></td>
                            </tr>
                            <tr>
                                <th>报账日期</th>
                                <td><t t-out="expense.date" t-options="{'widget': 'date'}"/></td>
                            </tr>
                            <tr>
                                <th>报账类型</th>
                                <td><t t-out="dict(expense._fields['x_report_type'].selection).get(expense.x_report_type)"/></td>
                            </tr>
                            <tr>
                                <th>费用类别</th>
                                <td><t t-out="expense.product_id.name or '-'"/></td>
                            </tr>
                            <tr>
                                <th>数量</th>
                                <td><t t-out="expense.quantity"/></td>
                            </tr>
                            <tr>
                                <th>单价</th>
                                <td>¥ <t t-out="'%.2f' % expense.price_unit"/></td>
                            </tr>
                            <tr class="table-success">
                                <th>总金额</th>
                                <td class="fw-bold">¥ <t t-out="'%.2f' % expense.total_amount"/></td>
                            </tr>
                            <tr>
                                <th>发票号</th>
                                <td><t t-out="expense.x_invoice_no or '-'"/></td>
                            </tr>
                            <tr>
                                <th>关联借款</th>
                                <td>
                                    <t t-if="expense.x_loan_id">
                                        <t t-out="expense.x_loan_id.name"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <th>状态</th>
                                <td>
                                    <span t-att-class="'badge ' + (expense.state == 'paid' and 'bg-success' or expense.state == 'approved' and 'bg-info' or 'bg-warning')">
                                        <t t-out="dict(expense._fields['state'].selection).get(expense.state)"/>
                                    </span>
                                </td>
                            </tr>
                        </table>

                        <!-- 审批按钮 -->
                        <t t-if="expense.state in ['reported', 'submitted']">
                            <div class="mt-3 pt-3 border-top">
                                <form method="POST" t-att-action="'/my/cfo/expenses/%s/approve' % expense.id">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-check me-1"/>审批通过
                                    </button>
                                    <a href="/my/cfo/expenses" class="btn btn-secondary ms-2">返回</a>
                                </form>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- 附件列表 -->
                <t t-if="attachments">
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fa fa-paperclip me-2"/>附件列表
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                <t t-foreach="attachments" t-as="att">
                                    <a t-att-href="'/my/cfo/expenses/%s/attachment/%s' % (expense.id, att.id)"
                                       class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="fa fa-file me-3 text-muted"/>
                                        <div class="flex-grow-1">
                                            <div><t t-out="att.name"/></div>
                                            <small class="text-muted">
                                                <t t-out="att.file_size" t-options="{'widget': 'size'}"/>
                                                · <t t-out="att.create_date" t-options="{'widget': 'datetime'}"/>
                                            </small>
                                        </div>
                                        <i class="fa fa-download text-primary"/>
                                    </a>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- 佣金审批列表 -->
    <template id="portal_cfo_commissions" name="CFO Commission Approvals">
        <t t-call="tour_cfo_portal.portal_cfo_layout">
            <div class="o_cfo_commissions">
                <h3 class="mb-3">
                    <i class="fa fa-money me-2"/>佣金审批
                </h3>
                <t t-if="commissions">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>导游</th>
                                <th>团队</th>
                                <th>佣金类型</th>
                                <th>计算日期</th>
                                <th class="text-end">金额</th>
                                <th>状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="commissions" t-as="com">
                                <tr>
                                    <td><t t-out="com.guide_id.name or '-'"/></td>
                                    <td>
                                        <t t-if="com.plan_id">
                                            <t t-out="com.plan_id.plan_code"/> - <t t-out="com.plan_id.plan_name"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td><t t-out="dict(com._fields['commission_type'].selection).get(com.commission_type)"/></td>
                                    <td><t t-out="com.compute_date" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end">¥ <t t-out="'%.2f' % com.amount"/></td>
                                    <td>
                                        <span class="badge bg-warning">
                                            <t t-out="dict(com._fields['state'].selection).get(com.state)"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-call="portal.pager"/>
                </t>
                <t t-else="">
                    <div class="text-center text-muted py-5">
                        <i class="fa fa-check-circle fa-3x mb-3"/>
                        <br/>
                        暂无待审批佣金
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- 借款审批列表 -->
    <template id="portal_cfo_loans" name="CFO Loan Approvals">
        <t t-call="tour_cfo_portal.portal_cfo_layout">
            <div class="o_cfo_loans">
                <h3 class="mb-3">
                    <i class="fa fa-credit-card me-2"/>借款审批
                </h3>
                <t t-if="loans">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>导游</th>
                                <th>借款说明</th>
                                <th>申请日期</th>
                                <th class="text-end">借款金额</th>
                                <th class="text-end">余额</th>
                                <th>状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="loans" t-as="loan">
                                <tr>
                                    <td><t t-out="loan.guide_id.name or '-'"/></td>
                                    <td><t t-out="loan.name or '-'"/></td>
                                    <td><t t-out="loan.apply_date" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end">¥ <t t-out="'%.2f' % loan.amount"/></td>
                                    <td class="text-end">¥ <t t-out="'%.2f' % loan.residual"/></td>
                                    <td>
                                        <span class="badge bg-info">
                                            <t t-out="dict(loan._fields['state'].selection).get(loan.state)"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-call="portal.pager"/>
                </t>
                <t t-else="">
                    <div class="text-center text-muted py-5">
                        <i class="fa fa-check-circle fa-3x mb-3"/>
                        <br/>
                        暂无待审批借款
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
