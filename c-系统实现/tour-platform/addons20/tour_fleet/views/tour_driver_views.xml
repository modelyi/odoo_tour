<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="view_tour_driver_search" model="ir.ui.view">
        <field name="name">tour.driver.search</field>
        <field name="model">tour.driver</field>
        <field name="arch" type="xml">
            <search string="司机搜索">
                <field name="name"/>
                <field name="driver_code"/>
                <field name="mobile"/>
                <filter name="active" string="启用" domain="[('active','=',True)]"/>
                <filter name="inactive" string="停用" domain="[('active','=',False)]"/>
                <separator/>
                <group name="group_by">
                    <filter name="group_sex" string="性别" context="{'group_by':'sex'}"/>
                    <filter name="group_licence_type" string="准驾车型" context="{'group_by':'licence_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tour_driver" model="ir.actions.act_window">
        <field name="name">司机档案</field>
        <field name="res_model">tour.driver</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_tour_driver_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Kanban View -->
    <record id="view_tour_driver_kanban" model="ir.ui.view">
        <field name="name">tour.driver.kanban</field>
        <field name="model">tour.driver</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="photo"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <widget name="web_ribbon" title="已归档" bg_color="text-bg-danger" invisible="active"/>
                        <aside class="o_kanban_aside_full">
                            <field name="photo" widget="image" options="{'img_class': 'object-fit-contain'}"/>
                        </aside>
                        <main class="ps-2">
                            <div class="mb-1">
                                <field name="name" class="mb-0 fw-bold fs-5"/>
                            </div>
                            <div><field name="mobile"/></div>
                            <div><field name="licence_type"/></div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_tour_driver_list" model="ir.ui.view">
        <field name="name">tour.driver.list</field>
        <field name="model">tour.driver</field>
        <field name="arch" type="xml">
            <list string="司机档案" sample="1" multi_edit="1">
                <field name="photo" widget="image" options="{'size': [24, 24]}" width="30" nolabel="1"/>
                <field name="name"/>
                <field name="driver_code"/>
                <field name="mobile"/>
                <field name="licence_type"/>
                <field name="driver_licence" optional="hide"/>
                <field name="sex" optional="hide"/>
                <field name="active" column_invisible="1"/>
                <field name="activity_exception_decoration" widget="activity_exception"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tour_driver_form" model="ir.ui.view">
        <field name="name">tour.driver.form</field>
        <field name="model">tour.driver</field>
        <field name="arch" type="xml">
            <form string="司机档案" duplicate="false">
                <sheet>
                    <widget name="web_ribbon" title="已归档" bg_color="text-bg-danger" invisible="active"/>
                    <div class="d-flex flex-column flex-sm-row align-items-center">
                        <div class="o_avatar ms-2 p-0">
                            <field name="photo" widget="image" options="{'size': [128, 128]}"/>
                        </div>
                        <div class="col-12 col-sm-6 col-md-7 col-lg-8 px-4">
                            <div class="oe_title mw-100 ps-0 pe-sm-2">
                                <h1>
                                    <field name="name" placeholder="司机姓名"/>
                                </h1>
                                <h5 class="d-flex align-items-baseline mb-0">
                                    <i class="fa fa-phone fa-fw me-1 text-primary"/>
                                    <field name="mobile" widget="phone" class="w-100 w-sm-75"/>
                                </h5>
                                <h5 class="d-flex align-items-baseline mb-0">
                                    <i class="fa fa-id-badge fa-fw me-1 text-primary"/>
                                    <field name="driver_code" class="w-100 w-sm-75"/>
                                </h5>
                                <h5 class="d-flex align-items-baseline mb-0">
                                    <i class="fa fa-user fa-fw me-1 text-primary"/>
                                    <field name="partner_id" placeholder="关联联系人" class="w-100 w-sm-75"/>
                                </h5>
                            </div>
                        </div>
                    </div>
                    <group string="基本信息">
                        <group>
                            <field name="driver_code"/>
                            <field name="help_code"/>
                            <field name="sex"/>
                            <field name="nation"/>
                            <field name="born_place"/>
                            <field name="edu"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="tel"/>
                            <field name="id_num"/>
                            <field name="zip_code"/>
                            <field name="addr"/>
                        </group>
                    </group>
                    <group string="驾驶资质">
                        <group>
                            <field name="licence_type"/>
                            <field name="driver_licence"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <notebook>
                        <page string="结算信息" name="settlement">
                            <group>
                                <group>
                                    <field name="loan_rate"/>
                                    <field name="cw_code"/>
                                </group>
                                <group>
                                    <field name="opening_bank"/>
                                    <field name="bank_account"/>
                                </group>
                            </group>
                        </page>
                        <page string="关联档案" name="related">
                            <group>
                                <field name="employee_id"/>
                                <field name="guide_id"/>
                                <field name="company_id"/>
                                <field name="department_id"/>
                                <field name="active"/>
                            </group>
                        </page>
                        <page string="备注" name="remark">
                            <group>
                                <field name="remark"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
