<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        页脚版权：Copyright © Company name → Copyright © 联洋海螺角旅行社
        priority 高于 website.footer_copyright_company_name(15)，确保覆盖默认占位。
    -->
    <template id="footer_copyright_brand" inherit_id="website.layout" priority="20">
        <xpath expr="//span[hasclass('o_footer_copyright_name')]" position="replace">
            <span class="o_footer_copyright_name me-2 small">Copyright &amp;copy; 联洋海螺角旅行社</span>
        </xpath>
    </template>

    <!--
        页脚「Connect with us」联系电话/邮箱占位覆盖：
        +1 555-555-5556 → 13877778888
        info@yourcompany.example.com → info@layaconch.com
        priority 30 > website.footer_custom(16)，在默认页脚插入后再替换。
        仅替换 <a> 文本/href，保留 s_text_block / oe_structure 可编辑结构，不破坏页面编辑器。
    -->
    <!-- 锚点不再依赖 `//footer` 前缀：20 的 `div#footer` 直接挂在 `<body>` 下
         （19 才有 `<footer>` 元素），改用「被替换文本本身」当锚，两版都成立。 -->
    <template id="footer_contact_info" inherit_id="website.footer_custom" priority="30">
        <xpath expr="//a[@href='mailto:info@yourcompany.example.com']" position="replace">
            <a href="mailto:info@layaconch.com">info@layaconch.com</a>
        </xpath>
        <xpath expr="//a[starts-with(@href,'tel:+1 555-555-5556')]" position="replace">
            <a href="tel:13877778888"><span class="o_force_ltr">13877778888</span></a>
        </xpath>
    </template>

    <!--
        页头文字块占位覆盖（website.header_text_element 全部 5 个变体）：
        电话 +1 555-555-5556 → 13877778888，邮箱 info@yourcompany.example.com → info@layaconch.com。
        逐变体替换 <a>，保留 class / 图标 / o_force_ltr 等可编辑结构，不破坏页面编辑器。
    -->
    <template id="header_contact_info" inherit_id="website.header_text_element" priority="30">
        <!-- phone_mail 变体：电话 -->
        <xpath expr="//a[contains(@href,'tel:') and @class='nav-link o_nav-link_secondary']" position="replace">
            <a href="tel:13877778888" class="nav-link o_nav-link_secondary">
                <small>
                    <i class="fa fa-1x fa-fw fa-phone me-1"/>&#847; <!-- Empty character needed to be able to delete the icon. -->
                    <span class="o_force_ltr">13877778888</span>
                </small>
            </a>
        </xpath>
        <!-- phone_mail 变体：邮箱 -->
        <xpath expr="//div[a[contains(@href,'tel:')]]/a[contains(@href,'mailto:')]" position="replace">
            <a href="mailto:info@layaconch.com" class="nav-link o_nav-link_secondary">
                <small>
                    <i class="fa fa-1x fa-fw fa-envelope me-1"/>
                    info@layaconch.com
                </small>
            </a>
        </xpath>
        <!-- mail 变体：仅邮箱 -->
        <xpath expr="//div[not(a[contains(@href,'tel:')])]/a[contains(@href,'mailto:')]" position="replace">
            <a href="mailto:info@layaconch.com" class="nav-link o_nav-link_secondary">
                <small><i class="fa fa-1x fa-fw fa-envelope me-1"/> info@layaconch.com</small>
            </a>
        </xpath>
        <!-- mail_stretched 变体：电话 -->
        <xpath expr="//a[contains(@class,'o_navlink_background_hover')]" position="replace">
            <a href="tel:13877778888" class="nav-link o_nav-link_secondary p-2 o_navlink_background_hover d-flex align-items-center h-100 text-reset">
                <i class="fa fa-1x fa-fw fa-phone me-1"/>
                <span class="o_force_ltr"><small>13877778888</small></span>
            </a>
        </xpath>
        <!-- 默认变体（t-else，当前生效）：电话 -->
        <xpath expr="//a[@class='nav-link o_nav-link_secondary p-2']" position="replace">
            <a href="tel:13877778888" class="nav-link o_nav-link_secondary p-2">
                <i class="fa fa-1x fa-fw fa-phone me-1"/>
                <span class="o_force_ltr"><small>13877778888</small></span>
            </a>
        </xpath>
    </template>

    <!--
        /contactus 页面正文联系信息块覆盖：**20 里已删除**。
        19 的 website.contactus 页面正文里有「+1 555-555-5556 / info@yourcompany.example.com」
        两个 <span>，20 的该页面只剩一张表单（号码只作为 input placeholder 出现），
        锚点不存在 → 装载期 ParseError。联系方式统一由页脚 footer_contact_info 承载。
        这是 19→20 的页面结构差异，不是本模块的回归；回落到 20 分支时需一并删除此记录。
    -->

    <!--
        页脚「About us / We are a team of passionate people」默认营销文案覆盖为品牌介绍。
        同 footer_contact_info：用被替换文本当锚，不依赖 `//footer` 前缀（20 已无该元素）。
    -->
    <template id="footer_about_us" inherit_id="website.footer_custom" priority="25">
        <xpath expr="//h5[text()='About us']" position="replace">
            <h5>关于我们</h5>
        </xpath>
        <!-- 同一个 template 内 spec 是顺序施加的：第一条已把 h5 换成中文，
             第二条只能按新文本找它的兄弟 <p>（原 h5 节点已不存在）。 -->
        <xpath expr="//h5[text()='关于我们']/following-sibling::p[1]" position="replace">
            <p>联洋海螺角旅行社专注品质跟团游与定制出行，覆盖国内与境外热门线路，为您提供专业、安心、可靠的旅行服务。</p>
        </xpath>
    </template>
</odoo>
